<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(LCP.Mobile.Components.Pages.Home).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(LCP.Mobile.Components.Layout.MobileLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(LCP.Mobile.Components.Layout.MobileLayout)">
            <p role="alert">Página no encontrada.</p>
        </LayoutView>
    </NotFound>
</Router>
