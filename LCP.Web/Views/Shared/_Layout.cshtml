<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/lcp-signalr.js" asp-append-version="true"></script>

<script>
    // GESTIÓN DE NOTIFICACIONES CON DESAPARICIÓN AL VER Y BORRADO PERSISTENTE
    const currentUserName = '@layoutUserName';
    const storageScope = currentUserName.replace(/[^a-zA-Z0-9]/g, '_');
    const KEY_OP_DISMISSED = `lcp_notif_op_dismissed_${storageScope}`;
    const KEY_OP_CLEARED_TIME = `lcp_notif_op_cleared_time_${storageScope}`;
    const KEY_MSG_DISMISSED = `lcp_notif_msg_dismissed_${storageScope}`;
    const KEY_MSG_CLEARED_TIME = `lcp_notif_msg_cleared_time_${storageScope}`;

    function getDismissedOperaciones() {
        try {
            return (JSON.parse(localStorage.getItem(KEY_OP_DISMISSED) || '[]')).map(String);
        } catch {
            return [];
        }
    }
    function saveDismissedOperacion(id) {
        const idStr = String(id);
        const list = getDismissedOperaciones();
        if (!list.includes(idStr)) {
            list.push(idStr);
            localStorage.setItem(KEY_OP_DISMISSED, JSON.stringify(list));
        }
    }
    function getClearedTimeOperaciones() {
        return parseInt(localStorage.getItem(KEY_OP_CLEARED_TIME) || '0', 10);
    }

    function getDismissedMensajes() {
        try {
            return (JSON.parse(localStorage.getItem(KEY_MSG_DISMISSED) || '[]')).map(String);
        } catch {
            return [];
        }
    }
    function saveDismissedMensaje(id) {
        const idStr = String(id);
        const list = getDismissedMensajes();
        if (!list.includes(idStr)) {
            list.push(idStr);
            localStorage.setItem(KEY_MSG_DISMISSED, JSON.stringify(list));
        }
    }
    function getClearedTimeMensajes() {
        return parseInt(localStorage.getItem(KEY_MSG_CLEARED_TIME) || '0', 10);
    }

    // CONTROL DE DROPDOWNS DE CAMPANAS DE NOTIFICACIÓN
    function toggleDropdownOperaciones(e) {
        if (e) e.stopPropagation();
        const dd = document.getElementById("dropdownNotifOperaciones");
        const ddMsg = document.getElementById("dropdownNotifMensajes");
        if (ddMsg) ddMsg.style.display = "none";

        if (dd.style.display === "none") {
            dd.style.display = "block";
            cargarNotificacionesOperaciones();
        } else {
            dd.style.display = "none";
        }
    }

    function toggleDropdownMensajes(e) {
        if (e) e.stopPropagation();
        const dd = document.getElementById("dropdownNotifMensajes");
        const ddOp = document.getElementById("dropdownNotifOperaciones");
        if (ddOp) ddOp.style.display = "none";

        if (dd.style.display === "none") {
            dd.style.display = "block";
            cargarNotificacionesMensajes();
        } else {
            dd.style.display = "none";
        }
    }

    // Cerrar al hacer clic fuera
    document.addEventListener("click", function (e) {
        const ddOp = document.getElementById("dropdownNotifOperaciones");
        const btnOp = document.getElementById("btnNotifOperaciones");
        if (ddOp && !ddOp.contains(e.target) && !btnOp.contains(e.target)) {
            ddOp.style.display = "none";
        }

        const ddMsg = document.getElementById("dropdownNotifMensajes");
        const btnMsg = document.getElementById("btnNotifMensajes");
        if (ddMsg && !ddMsg.contains(e.target) && !btnMsg.contains(e.target)) {
            ddMsg.style.display = "none";
        }
    });

    // 1. CARGA Y RENDERIZADO DE NOTIFICACIONES DE OPERACIONES
    let cacheOperacionesActuales = [];

    async function cargarNotificacionesOperaciones() {
        try {
            const resp = await fetch('/Notificaciones/Operaciones');
            if (resp.ok) {
                const list = await resp.json();
                const dismissed = getDismissedOperaciones();
                const clearedTime = getClearedTimeOperaciones();

                // Filtrar las que fueron visualizadas, borradas o limpiadas antes de este timestamp
                const activas = list.filter(n => {
                    const idStr = String(n.id);
                    if (dismissed.includes(idStr)) return false;
                    if (clearedTime > 0 && n.fechaHora) {
                        const notifEpoch = new Date(n.fechaHora).getTime();
                        if (notifEpoch <= clearedTime) return false;
                    }
                    return true;
                });

                cacheOperacionesActuales = activas;
                renderNotificacionesOperaciones(activas);
            }
        } catch (err) {
            console.error("Error al cargar notificaciones operativas", err);
        }
    }

    function renderNotificacionesOperaciones(list) {
        const cont = document.getElementById("listaNotifOperaciones");
        const badge = document.getElementById("badgeNotifOperaciones");
        const countLabel = document.getElementById("labelNotifOperacionesCount");

        if (!list || list.length === 0) {
            cont.innerHTML = `
                <div style="text-align: center; padding: 26px 16px; color: var(--lcp-text-muted); font-size: 12.5px;">
                    <div style="font-size: 24px; margin-bottom: 6px;">✓</div>
                    Sin novedades operativas pendientes
                </div>
            `;
            badge.style.display = "none";
            countLabel.textContent = "0 novedades";
            return;
        }

        badge.textContent = list.length;
        badge.style.display = "flex";
        countLabel.textContent = `${list.length} novedades`;

        cont.innerHTML = "";
        list.forEach(n => {
            const row = document.createElement("div");
            row.className = "notif-item-container";
            row.id = `notif-op-row-${n.id}`;

            row.innerHTML = `
                <a href="${n.url || '/Solicitudes'}" class="notif-item-link" onclick="marcarNotifOperacionVista(${n.id})">
                    <div class="notif-icon-circle">${n.icono || '🔔'}</div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 6px;">
                            <strong style="font-size: 12.5px; color: #192A33; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${n.titulo}</strong>
                            <span style="font-size: 10px; color: var(--lcp-text-muted); white-space: nowrap;">${n.tiempoHace}</span>
                        </div>
                        <div style="font-size: 11.5px; color: #555; margin-top: 2px; line-height: 1.35;">${n.mensaje}</div>
                    </div>
                </a>
                <button type="button" class="btn-borrar-notif" title="Borrar notificación de la lista" onclick="borrarNotifOperacion(event, ${n.id})">
                    ✕
                </button>
            `;
            cont.appendChild(row);
        });
    }

    function marcarNotifOperacionVista(id) {
        saveDismissedOperacion(id);
    }

    function borrarNotifOperacion(e, id) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        saveDismissedOperacion(id);

        const row = document.getElementById(`notif-op-row-${id}`);
        if (row) {
            row.style.opacity = '0';
            row.style.transform = 'translateX(24px)';
            setTimeout(() => {
                row.remove();
                cacheOperacionesActuales = cacheOperacionesActuales.filter(n => String(n.id) !== String(id));
                renderNotificacionesOperaciones(cacheOperacionesActuales);
            }, 200);
        }
    }

    function borrarTodasOperaciones(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        localStorage.setItem(KEY_OP_CLEARED_TIME, Date.now().toString());
        cacheOperacionesActuales.forEach(n => saveDismissedOperacion(n.id));
        cacheOperacionesActuales = [];
        renderNotificacionesOperaciones([]);
    }

    // 2. CARGA Y RENDERIZADO DE MENSAJES AL USUARIO
    let cacheMensajesActuales = [];

    async function cargarNotificacionesMensajes() {
        try {
            const resp = await fetch('/Notificaciones/Mensajes');
            if (resp.ok) {
                const list = await resp.json();
                const dismissed = getDismissedMensajes();
                const clearedTime = getClearedTimeMensajes();

                // Filtrar los que fueron visualizados o limpiados
                const activas = list.filter(m => {
                    const idStr = String(m.id);
                    if (dismissed.includes(idStr)) return false;
                    if (clearedTime > 0 && m.fechaHora) {
                        const msgEpoch = new Date(m.fechaHora).getTime();
                        if (msgEpoch <= clearedTime) return false;
                    }
                    return true;
                });

                cacheMensajesActuales = activas;
                renderNotificacionesMensajes(activas);
            }
        } catch (err) {
            console.error("Error al cargar mensajes del usuario", err);
        }
    }

    function renderNotificacionesMensajes(list) {
        const cont = document.getElementById("listaNotifMensajes");
        const badge = document.getElementById("badgeNotifMensajes");
        const countLabel = document.getElementById("labelNotifMensajesCount");

        if (!list || list.length === 0) {
            cont.innerHTML = `
                <div style="text-align: center; padding: 26px 16px; color: var(--lcp-text-muted); font-size: 12.5px;">
                    <div style="font-size: 24px; margin-bottom: 6px;">💬</div>
                    No tenés mensajes entrantes nuevos
                </div>
            `;
            badge.style.display = "none";
            countLabel.textContent = "0 mensajes";
            return;
        }

        badge.textContent = list.length;
        badge.style.display = "flex";
        countLabel.textContent = `${list.length} mensajes`;

        cont.innerHTML = "";
        list.forEach(m => {
            const row = document.createElement("div");
            row.className = "notif-item-container";
            row.id = `notif-msg-row-${m.id}`;
            const inicial = m.remitenteNombre ? m.remitenteNombre.charAt(0).toUpperCase() : 'U';

            row.innerHTML = `
                <a href="${m.url || '/Inbox'}" class="notif-item-link" onclick="marcarNotifMensajeVista(${m.id}, '${m.conversacionId}')">
                    <div class="notif-icon-circle" style="background: #28536B; color: #FFF; font-weight: 800; font-size: 12px;">${inicial}</div>
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 6px;">
                            <strong style="font-size: 12.5px; color: #192A33;">${m.remitenteNombre}</strong>
                            <span style="font-size: 10px; color: var(--lcp-text-muted); white-space: nowrap;">${m.tiempoHace}</span>
                        </div>
                        <div style="font-size: 11px; color: #28536B; font-weight: 600;">${m.asunto}</div>
                        <div style="font-size: 11.5px; color: #666; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${m.textoMensaje}</div>
                    </div>
                </a>
                <button type="button" class="btn-borrar-notif" title="Borrar mensaje de la lista" onclick="borrarNotifMensaje(event, ${m.id}, '${m.conversacionId}')">
                    ✕
                </button>
            `;
            cont.appendChild(row);
        });
    }

    function marcarNotifMensajeVista(id, convId) {
        saveDismissedMensaje(id);
        if (convId) {
            fetch(`/Notificaciones/MarcarMensajesLeidos?conversacionId=${encodeURIComponent(convId)}`, { method: 'POST' }).catch(() => {});
        }
    }

    function borrarNotifMensaje(e, id, convId) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        saveDismissedMensaje(id);
        if (convId) {
            fetch(`/Notificaciones/MarcarMensajesLeidos?conversacionId=${encodeURIComponent(convId)}`, { method: 'POST' }).catch(() => {});
        }

        const row = document.getElementById(`notif-msg-row-${id}`);
        if (row) {
            row.style.opacity = '0';
            row.style.transform = 'translateX(24px)';
            setTimeout(() => {
                row.remove();
                cacheMensajesActuales = cacheMensajesActuales.filter(m => String(m.id) !== String(id));
                renderNotificacionesMensajes(cacheMensajesActuales);
            }, 200);
        }
    }

    function borrarTodosMensajes(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        localStorage.setItem(KEY_MSG_CLEARED_TIME, Date.now().toString());
        cacheMensajesActuales.forEach(m => saveDismissedMensaje(m.id));
        cacheMensajesActuales = [];
        renderNotificacionesMensajes([]);
        // Marcar en la base de datos a través de la API
        fetch('/Notificaciones/MarcarMensajesLeidos', { method: 'POST' }).catch(() => {});
    }

    // Inicializar contadores en carga
    document.addEventListener("DOMContentLoaded", function () {
        cargarNotificacionesOperaciones();
        cargarNotificacionesMensajes();
        // Chequeo periódico cada 45 segundos
        setInterval(() => {
            cargarNotificacionesOperaciones();
            cargarNotificacionesMensajes();
        }, 45000);
    });

    // SISTEMA FLOTANTE DE POPUPS / MODALES DE NOTIFICACIÓN DEL SISTEMA (5 SEGUNDOS)
    window.mostrarPopupNotificacion = function(options) {
        if (!options) return;
        const container = document.getElementById("lcp-toast-container");
        if (!container) return;

        const tipo = (options.tipo || 'confirmacion').toLowerCase();
        const duracion = options.duracion || 5000;
        let badgeText = '✓ Confirmación de Acción';
        let iconoDefecto = '✓';
        let toastClass = 'lcp-toast-confirmacion';

        if (tipo === 'estado' || tipo === 'avance' || tipo === 'proceso' || tipo === 'info') {
            badgeText = '🔄 Avance de Estado';
            iconoDefecto = '🚀';
            toastClass = 'lcp-toast-estado';
        } else if (tipo === 'cancelado' || tipo === 'error' || tipo === 'alerta' || tipo === 'rechazado') {
            badgeText = '⛔ Proceso Cancelado / Alerta';
            iconoDefecto = '⛔';
            toastClass = 'lcp-toast-cancelado';
        }

        const titulo = options.titulo || (tipo === 'confirmacion' ? 'Acción Confirmada' : tipo === 'estado' ? 'Actualización de Estado' : 'Proceso Cancelado / Alerta');
        const mensaje = options.mensaje || '';
        const icono = options.icono || iconoDefecto;

        const toast = document.createElement("div");
        toast.className = `lcp-toast ${toastClass}`;
        toast.innerHTML = `
            <div class="lcp-toast-body">
                <div class="lcp-toast-icon-circle">${icono}</div>
                <div class="lcp-toast-content">
                    <span class="lcp-toast-badge">${badgeText}</span>
                    <div class="lcp-toast-title">${titulo}</div>
                    <div class="lcp-toast-message">${mensaje}</div>
                </div>
                <button type="button" class="lcp-toast-close" title="Cerrar notificación">✕</button>
            </div>
            <div class="lcp-toast-timer-bar">
                <div class="lcp-toast-timer-progress" style="animation-duration: ${duracion}ms;"></div>
            </div>
        `;

        container.appendChild(toast);

        let timer = setTimeout(() => cerrar(), duracion);

        function cerrar() {
            if (!toast.classList.contains("hiding")) {
                toast.classList.add("hiding");
                setTimeout(() => toast.remove(), 280);
            }
        }

        toast.querySelector(".lcp-toast-close").addEventListener("click", (e) => {
            e.stopPropagation();
            clearTimeout(timer);
            cerrar();
        });

        // Pausar countdown al colocar el mouse sobre el popup
        toast.addEventListener("mouseenter", () => {
            clearTimeout(timer);
            const bar = toast.querySelector(".lcp-toast-timer-progress");
            if (bar) bar.style.animationPlayState = "paused";
        });

        toast.addEventListener("mouseleave", () => {
            const bar = toast.querySelector(".lcp-toast-timer-progress");
            if (bar) bar.style.animationPlayState = "running";
            timer = setTimeout(() => cerrar(), 2000);
        });
    };
</script>

<!-- CONTENEDOR FLOTANTE PARA POPUPS/MODALES DE NOTIFICACIÓN DEL SISTEMA (5 SEGUNDOS) -->
<div id="lcp-toast-container" class="lcp-toast-container" aria-live="polite" aria-atomic="true"></div>

<!-- DISPARADORES AUTOMÁTICOS DESDE EL SERVIDOR (TEMPDATA) -->
@if (TempData["Mensaje"] != null || TempData["Success"] != null || TempData["Exito"] != null || TempData["MensajeExito"] != null)
{
    var msg = (TempData["Mensaje"] ?? TempData["Success"] ?? TempData["Exito"] ?? TempData["MensajeExito"])?.ToString() ?? "";
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            mostrarPopupNotificacion({
                tipo: 'confirmacion',
                titulo: 'Confirmación de Acción',
                mensaje: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(msg))',
                duracion: 5000
            });
        });
    </script>
}
@if (TempData["Estado"] != null || TempData["Avance"] != null)
{
    var msg = (TempData["Estado"] ?? TempData["Avance"])?.ToString() ?? "";
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            mostrarPopupNotificacion({
                tipo: 'estado',
                titulo: 'Actualización de Estado',
                mensaje: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(msg))',
                duracion: 5000
            });
        });
    </script>
}
@if (TempData["Error"] != null || TempData["Cancelado"] != null || TempData["Alerta"] != null)
{
    var msg = (TempData["Error"] ?? TempData["Cancelado"] ?? TempData["Alerta"])?.ToString() ?? "";
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            mostrarPopupNotificacion({
                tipo: 'cancelado',
                titulo: 'Proceso Cancelado / Alerta',
                mensaje: '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(msg))',
                duracion: 5000
            });
        });
    </script>
}

@{
    var currentCtrlName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool isInboxPage = currentCtrlName.Equals("Inbox", StringComparison.OrdinalIgnoreCase);
}

@if (!isInboxPage && User.Identity?.IsAuthenticated == true)
{
    <!-- HUD DE CHAT FLOTANTE ESTILO FACEBOOK EN PARTE INFERIOR DE LA PANTALLA -->
    <div id="lcp-fb-chat-dock" class="lcp-fb-chat-dock">
        <!-- Contenedor de Ventanitas Flotantes de Conversación -->
        <div id="lcp-fb-chat-windows" class="lcp-fb-chat-windows"></div>

        <!-- Botón / Pestaña Launcher Principal -->
        <div style="position: relative;">
            <div id="lcp-fb-directory-panel" class="lcp-fb-directory-panel" style="display: none;">
                <div class="lcp-fb-directory-header">
                    <span class="lcp-fb-directory-title">💬 Mensajes y Salas</span>
                    <button type="button" class="lcp-fb-btn-control" style="color: #666;" onclick="toggleFbChatDirectory()">✕</button>
                </div>
                <div class="lcp-fb-directory-search">
                    <input type="text" id="lcp-fb-search-input" placeholder="Buscar contacto o sala..." oninput="filtrarFbConversaciones(this.value)" />
                </div>
                <div class="lcp-fb-directory-list" id="lcp-fb-directory-list">
                    <div style="text-align: center; padding: 20px; font-size: 12px; color: var(--lcp-text-muted);">
                        Cargando conversaciones...
                    </div>
                </div>
                <div class="lcp-fb-directory-footer">
                    <a asp-controller="Inbox" asp-action="Index">Ver todos en Inbox completo ➔</a>
                </div>
            </div>

            <div id="lcp-fb-chat-launcher" class="lcp-fb-launcher" onclick="toggleFbChatDirectory()">
                <span class="lcp-fb-launcher-icon">💬</span>
                <span class="lcp-fb-launcher-text">Chats</span>
                <span id="lcp-fb-launcher-badge" class="lcp-fb-badge" style="display: none;">0</span>
            </div>
        </div>
    </div>

    <script>
        // LÓGICA DE VENTANAS FLOTANTES Y COMUNICACIÓN CHAT ESTILO FACEBOOK
        let fbConversacionesCache = [];
        let fbVentanasAbiertas = {};
        const currentUserIdNum = @(int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int cUId) ? cUId : 0);

        async function cargarFbConversaciones() {
            try {
                const resp = await fetch('/Inbox/ConversacionesAjax');
                if (resp.ok) {
                    const list = await resp.json();
                    fbConversacionesCache = list;
                    renderFbDirectorio(list);
                    actualizarBadgeTotalFb(list);
                }
            } catch (e) {
                console.error("Error al cargar conversaciones flotantes", e);
            }
        }

        function renderFbDirectorio(list) {
            const cont = document.getElementById("lcp-fb-directory-list");
            if (!cont) return;

            if (!list || list.length === 0) {
                cont.innerHTML = `
                    <div style="text-align: center; padding: 24px 16px; color: var(--lcp-text-muted); font-size: 12px;">
                        No tenés conversaciones activas todavía
                    </div>`;
                return;
            }

            cont.innerHTML = "";
            list.forEach(c => {
                const item = document.createElement("div");
                item.className = "lcp-fb-directory-item";
                item.onclick = () => abrirFbChat(c.conversacionId, c.titulo);

                const inicial = c.titulo ? c.titulo.charAt(0).toUpperCase() : 'C';
                const badgeHtml = c.mensajesNoLeidos > 0 ? `<span class="lcp-fb-badge">${c.mensajesNoLeidos}</span>` : '';

                item.innerHTML = `
                    <div class="lcp-fb-item-avatar">${inicial}</div>
                    <div class="lcp-fb-item-info">
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 4px;">
                            <div class="lcp-fb-item-title">${c.titulo}</div>
                            <span style="font-size: 10px; color: #888;">${c.horaUltimoMensaje || ''}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 4px;">
                            <div class="lcp-fb-item-sub">${c.ultimoMensaje || c.subtitulo || ''}</div>
                            ${badgeHtml}
                        </div>
                    </div>
                `;
                cont.appendChild(item);
            });
        }

        function actualizarBadgeTotalFb(list) {
            const badge = document.getElementById("lcp-fb-launcher-badge");
            if (!badge) return;
            const totalNoLeidos = list.reduce((acc, curr) => acc + (curr.mensajesNoLeidos || 0), 0);
            if (totalNoLeidos > 0) {
                badge.textContent = totalNoLeidos;
                badge.style.display = "inline-block";
            } else {
                badge.style.display = "none";
            }
        }

        function toggleFbChatDirectory() {
            const panel = document.getElementById("lcp-fb-directory-panel");
            if (!panel) return;
            if (panel.style.display === "none") {
                panel.style.display = "flex";
                cargarFbConversaciones();
            } else {
                panel.style.display = "none";
            }
        }

        function filtrarFbConversaciones(val) {
            if (!val || val.trim() === '') {
                renderFbDirectorio(fbConversacionesCache);
                return;
            }
            const q = val.toLowerCase();
            const filtradas = fbConversacionesCache.filter(c => 
                (c.titulo && c.titulo.toLowerCase().includes(q)) ||
                (c.subtitulo && c.subtitulo.toLowerCase().includes(q)) ||
                (c.ultimoMensaje && c.ultimoMensaje.toLowerCase().includes(q))
            );
            renderFbDirectorio(filtradas);
        }

        async function abrirFbChat(convId, titulo) {
            const dir = document.getElementById("lcp-fb-directory-panel");
            if (dir) dir.style.display = "none";

            const container = document.getElementById("lcp-fb-chat-windows");
            if (!container) return;

            let existing = document.getElementById(`fb-win-${convId}`);
            if (existing) {
                existing.classList.remove("minimized");
                const inp = document.getElementById(`fb-input-${convId}`);
                if (inp) inp.focus();
                return;
            }

            const openWins = container.querySelectorAll(".lcp-fb-window");
            if (openWins.length >= 2) {
                openWins[0].remove();
            }

            const win = document.createElement("div");
            win.className = "lcp-fb-window";
            win.id = `fb-win-${convId}`;
            win.setAttribute("data-conv", convId);

            win.innerHTML = `
                <div class="lcp-fb-window-header" onclick="toggleMinimizeFbWindow('${convId}')">
                    <div class="lcp-fb-window-title-wrap">
                        <span class="lcp-fb-window-status-dot"></span>
                        <strong class="lcp-fb-window-title">${titulo || convId}</strong>
                    </div>
                    <div class="lcp-fb-window-controls">
                        <button type="button" class="lcp-fb-btn-control" onclick="toggleMinimizeFbWindow('${convId}'); event.stopPropagation();" title="Minimizar">─</button>
                        <button type="button" class="lcp-fb-btn-control" onclick="closeFbWindow('${convId}'); event.stopPropagation();" title="Cerrar">✕</button>
                    </div>
                </div>
                <div class="lcp-fb-window-body" id="fb-body-${convId}">
                    <div style="text-align: center; padding: 20px; font-size: 11px; color: #888;">Cargando mensajes...</div>
                </div>
                <div class="lcp-fb-window-footer">
                    <input type="text" class="lcp-fb-input" id="fb-input-${convId}" placeholder="Escribí un mensaje..." onkeydown="handleFbKeyDown(event, '${convId}')" />
                    <button type="button" class="lcp-fb-btn-send" onclick="sendFbMessage('${convId}')" title="Enviar">➤</button>
                </div>
            `;

            container.appendChild(win);
            fbVentanasAbiertas[convId] = { convId, titulo, minimizada: false };

            if (typeof chatConnection !== "undefined" && chatConnection && chatConnection.state === "Connected") {
                chatConnection.invoke("UnirseConversacion", convId).catch(() => {});
            }

            await cargarHistorialFbWindow(convId);

            const inputEl = document.getElementById(`fb-input-${convId}`);
            if (inputEl) inputEl.focus();
        }

        function toggleMinimizeFbWindow(convId) {
            const win = document.getElementById(`fb-win-${convId}`);
            if (win) {
                win.classList.toggle("minimized");
                if (fbVentanasAbiertas[convId]) {
                    fbVentanasAbiertas[convId].minimizada = win.classList.contains("minimized");
                }
            }
        }

        function closeFbWindow(convId) {
            const win = document.getElementById(`fb-win-${convId}`);
            if (win) win.remove();
            delete fbVentanasAbiertas[convId];
        }

        async function cargarHistorialFbWindow(convId) {
            const body = document.getElementById(`fb-body-${convId}`);
            if (!body) return;

            try {
                const resp = await fetch(`/Inbox/HistorialAjax?id=${encodeURIComponent(convId)}`);
                if (resp.ok) {
                    const msgs = await resp.json();
                    body.innerHTML = "";
                    if (!msgs || msgs.length === 0) {
                        body.innerHTML = '<div style="text-align: center; padding: 20px; font-size: 11.5px; color: #888;">Iniciá la conversación enviando un mensaje...</div>';
                    } else {
                        msgs.forEach(m => appendFbBubble(convId, m));
                        body.scrollTop = body.scrollHeight;
                    }

                    fetch(`/Notificaciones/MarcarMensajesLeidos?conversacionId=${encodeURIComponent(convId)}`, { method: 'POST' }).catch(() => {});
                }
            } catch (e) {
                body.innerHTML = '<div style="text-align: center; color: #C0392B; padding: 10px; font-size: 11px;">Error al cargar mensajes.</div>';
            }
        }

        function appendFbBubble(convId, m) {
            const body = document.getElementById(`fb-body-${convId}`);
            if (!body) return;

            // Evitar mensajes duplicados si ya existen en el contenedor
            if (m.id && body.querySelector(`#fb-msg-${m.id}`)) {
                return;
            }

            const esMio = m.remitenteUsuarioId === currentUserIdNum;
            const bubble = document.createElement("div");
            if (m.id) {
                bubble.id = `fb-msg-${m.id}`;
            }

            let bubbleClass = esMio ? "lcp-fb-msg-sent" : "lcp-fb-msg-recv";
            if (m.esIncidenteRuta) bubbleClass = "lcp-fb-msg-incident";

            bubble.className = `lcp-fb-msg ${bubbleClass}`;
            const hora = m.horaFormateada || (m.fechaHoraEnvio ? new Date(m.fechaHoraEnvio).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '');

            bubble.innerHTML = `
                ${!esMio ? `<div style="font-size: 9.5px; font-weight: 700; opacity: 0.85; margin-bottom: 2px;">${m.remitenteNombre || 'Usuario'}</div>` : ''}
                ${m.esIncidenteRuta ? '<div style="font-weight: 800; font-size: 10.5px; margin-bottom: 2px;">🚨 INCIDENTE EN RUTA</div>' : ''}
                <div>${m.textoMensaje || ''}</div>
                <div class="lcp-fb-msg-time">${hora}</div>
            `;

            body.appendChild(bubble);
            body.scrollTop = body.scrollHeight;
        }

        function handleFbKeyDown(e, convId) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendFbMessage(convId);
            }
        }

        async function sendFbMessage(convId) {
            const input = document.getElementById(`fb-input-${convId}`);
            if (!input || !input.value.trim()) return;

            const texto = input.value.trim();
            input.value = "";
            input.focus();

            try {
                const resp = await fetch('/Inbox/EnviarAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conversacionId: convId,
                        textoMensaje: texto,
                        esIncidenteRuta: false
                    })
                });

                if (resp.ok) {
                    const creado = await resp.json();
                    appendFbBubble(convId, creado);
                }
            } catch (err) {
                console.error("Excepción al enviar mensaje flotante", err);
            }
        }

        window.handleFbMessageReceived = function(m) {
            if (!m) return;
            const convId = m.conversacionId;

            const win = document.getElementById(`fb-win-${convId}`);
            if (win) {
                appendFbBubble(convId, m);
                if (!win.classList.contains("minimized")) {
                    fetch(`/Notificaciones/MarcarMensajesLeidos?conversacionId=${encodeURIComponent(convId)}`, { method: 'POST' }).catch(() => {});
                }
            } else {
                cargarFbConversaciones();
                if (typeof cargarNotificacionesMensajes === "function") {
                    cargarNotificacionesMensajes();
                }
            }
        };

        document.addEventListener("DOMContentLoaded", function () {
            cargarFbConversaciones();
            setInterval(cargarFbConversaciones, 30000);
            if (typeof iniciarChatHub === "function") {
                iniciarChatHub(null);
            }
        });
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
