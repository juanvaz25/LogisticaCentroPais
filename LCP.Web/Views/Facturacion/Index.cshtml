            </div>
        </div>

        <div class="lcp-modal-footer" style="padding: 14px 24px; background: #F8F6F0; border-top: 1px solid var(--lcp-card-border); display: flex; justify-content: space-between; align-items: center;">
            <button type="button" class="btn-lcp-outline btn-lcp-sm" onclick="cerrarFichaHabilitacionModal()">Cerrar</button>
            <form id="formHabilitarModal" asp-action="HabilitarDarsena" method="post" style="margin: 0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="mfhInputIdHabilitar" value="" />
                <button type="submit" class="btn-lcp-primary btn-lcp-sm" style="background-color: #2E7D32; border-color: #2E7D32; font-weight: 700;">
                    ✓ Confirmar y Habilitar Dársena
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: FICHA DE EVALUACIÓN TÉCNICA DE DÁRSENA -->
<div id="modalFichaEvaluacion" class="lcp-modal-backdrop" style="display: none;">
    <div class="lcp-modal" style="max-width: 620px;">
        <div class="lcp-modal-header" style="background: linear-gradient(135deg, #1B5277 0%, #28536B 100%); color: #FFF; padding: 18px 24px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 26px;">🛡️</span>
                <div>
                    <h3 id="mfevTitulo" style="font-size: 18px; font-weight: 800; color: #FFF; margin: 0;">Ficha de Evaluación Técnica</h3>
