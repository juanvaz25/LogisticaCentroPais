            <div style="background: #F8F6F0; border: 1px solid var(--lcp-card-border); border-radius: 8px; padding: 16px; font-size: 13px; line-height: 1.8;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="color: var(--lcp-text-muted);">Dársena Solicitada:</span>
                    <strong id="mfevDarsena" style="font-size: 16px; color: #192A33;">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="color: var(--lcp-text-muted);">Cliente Postulante:</span>
                    <strong id="mfevCliente" style="color: #192A33;">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="color: var(--lcp-text-muted);">Mercadería a Almacenar:</span>
                    <span id="mfevMercaderia" style="font-weight: 700; color: #28536B;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="color: var(--lcp-text-muted);">Régimen Térmico:</span>
                    <span id="mfevRegimen" style="font-weight: 600;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                    <span style="color: var(--lcp-text-muted); white-space: nowrap;">Consideraciones Especiales:</span>
                    <span id="mfevConsideraciones" style="text-align: right; font-weight: 600; color: #6D4C41;">-</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; padding-top: 8px; border-top: 1px solid #E5DFD5;">
                    <span style="color: var(--lcp-text-muted);">Plan Solicitado:</span>
                    <strong id="mfevPlan">-</strong>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: var(--lcp-text-muted);">Monto de Contrato:</span>
                    <strong id="mfevMonto" style="font-size: 16px; color: #192A33;">$ -</strong>
                </div>
            </div>

            <div style="margin-top: 14px; background: #E8F5E9; border-left: 4px solid #2ECC71; padding: 10px 14px; border-radius: 6px; font-size: 12px; color: #1E663B;">
                <strong>ℹ️ Al confirmar alquiler:</strong> El cliente recibirá notificación para abonar el canon y subir la factura / comprobante.
            </div>
        </div>

        <div class="lcp-modal-footer" style="padding: 14px 24px; background: #F8F6F0; border-top: 1px solid var(--lcp-card-border); display: flex; justify-content: space-between; align-items: center;">
            <button type="button" class="btn-lcp-outline btn-lcp-sm" onclick="cerrarFichaEvaluacionModal()">Cerrar</button>
            <div style="display: flex; gap: 8px;">
                <form id="formAprobarDarsenaModal" asp-action="AprobarSolicitudDarsena" method="post" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="mfevInputIdAprobar" value="" />
                    <input type="hidden" name="observacion" value="Viabilidad técnica aprobada para la mercadería declarada." />
                    <button type="submit" class="btn-lcp-primary btn-lcp-sm" style="background-color: #2B7A4B; border-color: #2B7A4B; font-weight: 700;">
                        ✓ Confirmar Alquiler
                    </button>
                </form>
                <button type="button" class="btn-lcp-outline btn-lcp-sm" style="color: #9D2424; border-color: #9D2424;" onclick="rechazarDesdeFichaModal()">
                    ✕ Rechazar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirFichaHabilitacionModal(id, darsena, cliente, mercaderia, regimen, consideraciones, plan, monto, urlComprobante) {
            document.getElementById("mfhDarsena").textContent = darsena;
            document.getElementById("mfhCliente").textContent = cliente;
            document.getElementById("mfhMercaderia").textContent = mercaderia;
            document.getElementById("mfhRegimen").textContent = regimen;
            document.getElementById("mfhConsideraciones").textContent = consideraciones;
            document.getElementById("mfhPlan").textContent = plan;
            document.getElementById("mfhMonto").textContent = `$ ${monto}`;
            document.getElementById("mfhInputIdHabilitar").value = id;

            const linkComp = document.getElementById("mfhLinkComprobante");
            if (urlComprobante) {
                linkComp.href = `http://localhost:5152${urlComprobante}`;
                document.getElementById("mfhContenedorComprobante").style.display = "block";
            } else {
                document.getElementById("mfhContenedorComprobante").style.display = "none";
            }

            document.getElementById("modalFichaHabilitacion").style.display = "flex";
        }
        function cerrarFichaHabilitacionModal() {
            document.getElementById("modalFichaHabilitacion").style.display = "none";
        }

        let mfevIdActual = 0;
        let mfevDarsenaActual = "";
        let mfevClienteActual = "";

        function abrirFichaEvaluacionModal(id, darsena, cliente, mercaderia, regimen, consideraciones, plan, monto) {
            mfevIdActual = id;
            mfevDarsenaActual = darsena;
            mfevClienteActual = cliente;

            document.getElementById("mfevDarsena").textContent = darsena;
            document.getElementById("mfevCliente").textContent = cliente;
            document.getElementById("mfevMercaderia").textContent = mercaderia;
            document.getElementById("mfevRegimen").textContent = regimen;
            document.getElementById("mfevConsideraciones").textContent = consideraciones;
            document.getElementById("mfevPlan").textContent = plan;
            document.getElementById("mfevMonto").textContent = `$ ${monto}`;
            document.getElementById("mfevInputIdAprobar").value = id;

            document.getElementById("modalFichaEvaluacion").style.display = "flex";
        }
        function cerrarFichaEvaluacionModal() {
            document.getElementById("modalFichaEvaluacion").style.display = "none";
        }

        function rechazarDesdeFichaModal() {
            cerrarFichaEvaluacionModal();
            abrirModalRechazoDarsena(mfevIdActual, mfevDarsenaActual, mfevClienteActual);
        }

        function abrirModalRechazoDarsena(id, darsenaCodigo, cliente) {
            document.getElementById("modalRechazoId").value = id;
            document.getElementById("modalRechazoSubtitulo").textContent = `Dársena ${darsenaCodigo} - Cliente: ${cliente}. Especifique la causa del dictamen desfavorable.`;
            document.getElementById("modalRechazoDarsena").style.display = "flex";
        }
        function cerrarModalRechazoDarsena() {
            document.getElementById("modalRechazoDarsena").style.display = "none";
        }


        let currentFichaLiqId = 0;
        let currentFichaLiqComp = "";

        // Almacén seguro de liquidaciones cargadas desde el servidor
        const liquidacionesRaw = @Html.Raw(liquidacionesJson);
        const liquidacionesMap = new Map();
        if (Array.isArray(liquidacionesRaw)) {
            liquidacionesRaw.forEach(item => {
                if (item && (item.id != null || item.Id != null)) {
                    liquidacionesMap.set(Number(item.id ?? item.Id), item);
                }
            });
        }

        // Función normalizadora que tolera tanto camelCase como PascalCase sin fallos
        function normalizarLiquidacion(liq) {
            if (!liq) return {};
            const rawDocs = liq.documentosRespaldatorios || liq.DocumentosRespaldatorios || [];
            const safeDocs = Array.isArray(rawDocs) ? rawDocs.map(d => ({
                id: d.id ?? d.Id ?? 0,
                tipoDocumento: d.tipoDocumento || d.TipoDocumento || 'Comprobante',
                nombreArchivo: d.nombreArchivo || d.NombreArchivo || 'archivo',
                rutaUrl: (d.rutaUrl || d.RutaUrl || '').trim(),
                subidoPorNombre: d.subidoPorNombre || d.SubidoPorNombre || 'Usuario',
                fechaSubida: d.fechaSubida || d.FechaSubida || ''
            })) : [];

            return {
                id: Number(liq.id ?? liq.Id ?? 0),
                numeroComprobante: liq.numeroComprobante || liq.NumeroComprobante || '',
                clienteRazonSocial: liq.clienteRazonSocial || liq.ClienteRazonSocial || '-',
                clienteCUIT: liq.clienteCUIT || liq.ClienteCUIT || 'No registrado',
                clienteEmail: liq.clienteEmail || liq.ClienteEmail || '',
                clienteTelefono: liq.clienteTelefono || liq.ClienteTelefono || '',
                tipoLiquidacionNombre: liq.tipoLiquidacionNombre || liq.TipoLiquidacionNombre || 'Servicio General',
                codigoSolicitud: liq.codigoSolicitud || liq.CodigoSolicitud || '',
                darsenaCodigo: liq.darsenaCodigo || liq.DarsenaCodigo || '',
                modalidadTransporte: liq.modalidadTransporte || liq.ModalidadTransporte || '',
                conductorNombre: liq.conductorNombre || liq.ConductorNombre || '',
                conductorPatente: liq.conductorPatente || liq.ConductorPatente || '',
                ciudadOrigen: liq.ciudadOrigen || liq.CiudadOrigen || '',
                ciudadDestino: liq.ciudadDestino || liq.CiudadDestino || '',
                descripcionMercaderia: liq.descripcionMercaderia || liq.DescripcionMercaderia || '',
                pesoTotalKg: Number(liq.pesoTotalKg ?? liq.PesoTotalKg ?? 0),
                volumenTotalM3: Number(liq.volumenTotalM3 ?? liq.VolumenTotalM3 ?? 0),
                variablesAplicadasResumen: liq.variablesAplicadasResumen || liq.VariablesAplicadasResumen || '',
                subtotalPeso: Number(liq.subtotalPeso ?? liq.SubtotalPeso ?? 0),
                subtotalVolumen: Number(liq.subtotalVolumen ?? liq.SubtotalVolumen ?? 0),
                subtotalDistancia: Number(liq.subtotalDistancia ?? liq.SubtotalDistancia ?? 0),
                subtotalTiempoDepositoOAlquiler: Number(liq.subtotalTiempoDepositoOAlquiler ?? liq.SubtotalTiempoDepositoOAlquiler ?? 0),
                importeTotal: Number(liq.importeTotal ?? liq.ImporteTotal ?? 0),
                estado: Number(liq.estado ?? liq.Estado ?? 1),
                estadoNombre: liq.estadoNombre || liq.EstadoNombre || 'Pendiente de auditoría',
                auditadoPorUsuarioId: liq.auditadoPorUsuarioId ?? liq.AuditadoPorUsuarioId,
                auditadoPorNombre: liq.auditadoPorNombre || liq.AuditadoPorNombre || '',
                fechaAuditoria: liq.fechaAuditoria || liq.FechaAuditoria,
                observacionAuditoria: liq.observacionAuditoria || liq.ObservacionAuditoria || '',
                fechaEmision: liq.fechaEmision || liq.FechaEmision,
                documentosRespaldatorios: safeDocs
            };
        }

        // Abre la ficha usando el ID directamente desde la tabla
        async function abrirFichaLiquidacionModalPorId(id) {
            const numId = Number(id);
            let item = liquidacionesMap.get(numId);
            if (!item) {
                console.warn("Liquidación no encontrada localmente:", id);
                return;
            }

            let norm = normalizarLiquidacion(item);

            // Renderizado inmediato
            renderFichaLiquidacionModal(norm);

            // Actualización asíncrona de comprobantes en tiempo real
            try {
                const res = await fetch(`/Facturacion/Documentos?liquidacionId=${numId}`);
                if (res.ok) {
                    const freshDocs = await res.json();
                    if (Array.isArray(freshDocs)) {
                        norm.documentosRespaldatorios = freshDocs.map(d => ({
                            id: d.id ?? d.Id ?? 0,
                            tipoDocumento: d.tipoDocumento || d.TipoDocumento || 'Comprobante',
                            nombreArchivo: d.nombreArchivo || d.NombreArchivo || 'archivo',
                            rutaUrl: (d.rutaUrl || d.RutaUrl || '').trim(),
                            subidoPorNombre: d.subidoPorNombre || d.SubidoPorNombre || 'Usuario',
                            fechaSubida: d.fechaSubida || d.FechaSubida || ''
                        }));
                        // Actualizar objeto en mapa
                        item.documentosRespaldatorios = freshDocs;
                        // Si el usuario aún tiene el modal abierto para esta liquidación, actualizarlo
                        if (currentFichaLiqId === numId) {
                            renderFichaLiquidacionModal(norm);
                        }
                    }
                }
            } catch (err) {
                console.warn("No se pudieron refrescar los documentos vía fetch:", err);
            }
        }

        // Compatibilidad por si se llama con objeto o ID
        function abrirFichaLiquidacionModal(liq) {
            if (typeof liq === 'number' || typeof liq === 'string') {
                abrirFichaLiquidacionModalPorId(liq);
                return;
            }
            renderFichaLiquidacionModal(normalizarLiquidacion(liq));
        }

        // Renderizado del modal y sus pestañas
        function renderFichaLiquidacionModal(liq) {
            currentFichaLiqId = liq.id;
            currentFichaLiqComp = liq.numeroComprobante;

            document.getElementById("mflTitulo").textContent = `Ficha de Liquidación: ${liq.numeroComprobante || '-'}`;
            
            // Estado Badge
            const badge = document.getElementById("mflBadgeEstado");
            badge.textContent = liq.estadoNombre || (liq.estado === 2 ? "Validada" : liq.estado === 1 ? "Pendiente" : "Observada");
            badge.className = "badge-estado " + (liq.estado === 2 ? "badge-validada" : liq.estado === 1 ? "badge-pendiente" : "badge-observada");

            // Subtítulo
            let fechaEmisionTxt = "-";
            if (liq.fechaEmision) {
                try {
                    fechaEmisionTxt = new Date(liq.fechaEmision).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + " hs";
                } catch (e) {
                    fechaEmisionTxt = liq.fechaEmision;
                }
            }
            document.getElementById("mflSubtitulo").textContent = `Comprobante fiscal · Emitido el ${fechaEmisionTxt} por Logística Centro País`;

            // Datos Comerciales
            document.getElementById("mflClienteRazonSocial").textContent = liq.clienteRazonSocial || "-";
            document.getElementById("mflClienteCUIT").textContent = liq.clienteCUIT || "No registrado";
            document.getElementById("mflClienteContacto").textContent = `${liq.clienteEmail || '-'} · ${liq.clienteTelefono || '-'}`;
            document.getElementById("mflTipoLiquidacion").textContent = liq.tipoLiquidacionNombre || "Servicio General";

            // Datos Operativos
            const opRef = liq.codigoSolicitud ? `Operación #${liq.codigoSolicitud}` : (liq.darsenaCodigo ? `Dársena ${liq.darsenaCodigo}` : "Servicio de Depósito");
            document.getElementById("mflOperacionRef").textContent = opRef;

            const modTrans = liq.modalidadTransporte === "FlotaLCP" ? "Camión Flota LCP (Doble Viaje)" : (liq.modalidadTransporte ? "Transporte Propio del Cliente" : "Almacenamiento en Dársena");
            document.getElementById("mflModalidadTransporte").textContent = modTrans;

            const choferTxt = liq.conductorNombre ? `${liq.conductorNombre} ${liq.conductorPatente ? '· Patente ' + liq.conductorPatente : ''}` : "Sin chofer designado";
            document.getElementById("mflChoferAsignado").textContent = choferTxt;

            const trayectoTxt = `${liq.ciudadOrigen || 'Origen'} ➔ ${liq.ciudadDestino || 'Base LCP Santa Rosa'}`;
            document.getElementById("mflTrayecto").textContent = trayectoTxt;

            const cargaTxt = `${liq.descripcionMercaderia || 'Carga declarada'} · ${liq.pesoTotalKg.toLocaleString('es-AR')} kg · ${liq.volumenTotalM3.toLocaleString('es-AR')} m³`;
            document.getElementById("mflCargaDetalle").textContent = cargaTxt;

            // Desglose
            document.getElementById("mflResumenVariables").textContent = liq.variablesAplicadasResumen || "";
            document.getElementById("mflSubPeso").textContent = `$ ${liq.subtotalPeso.toLocaleString('es-AR')}`;
            document.getElementById("mflSubVol").textContent = `$ ${liq.subtotalVolumen.toLocaleString('es-AR')}`;
            document.getElementById("mflSubDist").textContent = `$ ${liq.subtotalDistancia.toLocaleString('es-AR')}`;
            document.getElementById("mflSubTiempo").textContent = `$ ${liq.subtotalTiempoDepositoOAlquiler.toLocaleString('es-AR')}`;
            document.getElementById("mflTotalImporte").textContent = `$ ${liq.importeTotal.toLocaleString('es-AR', { minimumFractionDigits: 2 })}`;

            // Formulario de subida rápida
            document.getElementById("mflInputSubirLiqId").value = liq.id;
            document.getElementById("mflPanelSubirFactura").style.display = "none";

            // Documentos y Facturas
            const docs = liq.documentosRespaldatorios || [];
            const tieneFacturas = docs.length > 0;

            // Banner Alerta
            const banner = document.getElementById("mflBannerAlerta");
            if (tieneFacturas) {
                banner.innerHTML = `
                    <div style="background-color: #ECFDF5; border: 1px solid #10B981; border-radius: 8px; padding: 12px 16px; color: #065F46; display: flex; align-items: flex-start; gap: 10px;">
                        <span style="font-size: 20px;">✓</span>
                        <div>
                            <strong style="display: block; font-size: 13px; margin-bottom: 2px;">COMPROBANTE RESPALDATORIO DISPONIBLE (${docs.length} ARCHIVO/S)</strong>
                            <span style="font-size: 12px; line-height: 1.5;">El cliente o chofer ya han adjuntado la factura comercial o remito firmado. La liquidación cumple con los requisitos contables para su aprobación definitiva.</span>
                        </div>
                    </div>`;
            } else {
                banner.innerHTML = `
                    <div style="background-color: #FEF3C7; border: 1px solid #F59E0B; border-radius: 8px; padding: 12px 16px; color: #92400E; display: flex; align-items: flex-start; gap: 10px;">
                        <span style="font-size: 20px;">🔒</span>
                        <div>
                            <strong style="display: block; font-size: 13px; margin-bottom: 2px;">CONFIRMACIÓN BLOQUEADA: FALTA CARGAR FACTURA O REMITO</strong>
                            <span style="font-size: 12px; line-height: 1.5;">Para poder confirmar y validar esta liquidación, <strong>es obligatorio</strong> que los actores involucrados (el Cliente y/o el Chofer) carguen la factura comercial o remito de la operación.</span>
                        </div>
                    </div>`;
            }

            document.getElementById("mflCantComprobantesBadge").textContent = `${docs.length} archivo(s)`;

            // Renderizar lista de comprobantes
            const contFacturas = document.getElementById("mflContenedorFacturas");
            if (!tieneFacturas) {
                contFacturas.innerHTML = `
                    <div style="padding: 18px; text-align: center; color: var(--lcp-text-muted); background: #FAF5EB; border-radius: 6px; font-size: 12.5px;">
                        ⚠️ Aún no se han adjuntado facturas o remitos para esta liquidación.<br/>
                        <span style="font-size: 11.5px; color: #8C6A3E;">Podés adjuntar uno haciendo clic en el botón <strong>"+ Adjuntar Factura / Remito"</strong> superior.</span>
                    </div>`;
            } else {
                let html = `<table class="lcp-table" style="font-size: 12px; margin: 0;">
                    <thead>
                        <tr>
                            <th>Tipo Comprobante</th>
                            <th>Archivo</th>
                            <th>Subido por</th>
                            <th>Fecha</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>`;

                docs.forEach(d => {
                    const tipoDoc = d.tipoDocumento || 'Comprobante';
                    const nomArch = d.nombreArchivo || 'comprobante';
                    const subPor = d.subidoPorNombre || 'Usuario';
                    let fSubTxt = '-';
                    if (d.fechaSubida) {
                        try {
                            fSubTxt = new Date(d.fechaSubida).toLocaleString('es-AR');
                        } catch (e) {
                            fSubTxt = d.fechaSubida;
                        }
                    }

                    const ruta = (d.rutaUrl || '').trim();
                    const rutaLower = ruta.toLowerCase();
                    const esImg = rutaLower.endsWith('.jpg') || rutaLower.endsWith('.jpeg') || rutaLower.endsWith('.png') || rutaLower.endsWith('.webp');

                    let urlCompleta = '#';
                    if (ruta) {
                        if (ruta.startsWith('http://') || ruta.startsWith('https://')) {
                            urlCompleta = ruta;
                        } else if (ruta.startsWith('/uploads')) {
                            urlCompleta = ruta;
                        } else {
                            urlCompleta = `http://localhost:5152${ruta.startsWith('/') ? '' : '/'}${ruta}`;
                        }
                    }

                    const tipoTitulo = tipoDoc === 'Factura' ? '🧾 Factura Comercial' : 
                                       (tipoDoc === 'Remito' || tipoDoc === 'RemitoConformado' ? '📄 Remito Firmado' : 
                                       (tipoDoc === 'ConstanciaPago' ? '💳 Comprobante Pago' : tipoDoc));

                    html += `<tr>
                        <td>
                            <strong style="color: #192A33;">${tipoTitulo}</strong>
                        </td>
                        <td style="font-family: monospace; color: #28536B;">${nomArch}</td>
                        <td>${subPor}</td>
                        <td style="font-size: 11px; color: var(--lcp-text-muted);">${fSubTxt}</td>
                        <td style="text-align: right;">
                            <div style="display: inline-flex; gap: 6px;">
                                ${esImg ? `<button type="button" class="btn-lcp-outline btn-lcp-sm" style="padding: 2px 8px; font-size: 11px;" onclick="abrirZoomImagenFactura('${urlCompleta}', '${nomArch}')">🔍 Zoom</button>` : ''}
                                <a href="${urlCompleta}" target="_blank" class="btn-lcp-primary btn-lcp-sm" style="padding: 2px 8px; font-size: 11px; display: inline-flex; align-items: center; gap: 4px;">
                                    👁️ Abrir
                                </a>
                            </div>
                        </td>
                    </tr>`;
                });

                html += `</tbody></table>`;
                contFacturas.innerHTML = html;
            }

            // Historial de auditoría
            const secAud = document.getElementById("mflSeccionAuditoria");
            if (liq.auditadoPorNombre || liq.observacionAuditoria) {
                secAud.style.display = "block";
                let fechaAudTxt = "";
                if (liq.fechaAuditoria) {
                    try {
                        fechaAudTxt = " el " + new Date(liq.fechaAuditoria).toLocaleString('es-AR') + " hs";
                    } catch (e) {
                        fechaAudTxt = " el " + liq.fechaAuditoria;
                    }
                }
                document.getElementById("mflDetalleAuditoria").innerHTML = `
                    Dictamen emitido por <strong>${liq.auditadoPorNombre || 'Auditor'}</strong>${fechaAudTxt}.<br/>
                    ${liq.observacionAuditoria ? `<span style="color: #9D2424; font-weight: 600;">Observación: ${liq.observacionAuditoria}</span>` : 'Sin observaciones técnicas adicionales.'}
                `;
            } else {
                secAud.style.display = "none";
            }

            // Acciones para Auditor / Admin (exclusivo para perfiles con permisos de auditoría)
            const esAuditorOAdmin = @((User.IsInRole(Roles.Auditor) || User.IsInRole(Roles.Administrador)).ToString().ToLower());
            const secAccionesAuditor = document.getElementById("mflAccionesAuditor");
            const contBotonVal = document.getElementById("mflBotonValidarContainer");
            const contMsgCliente = document.getElementById("mflMensajeEstadoCliente");

            if (esAuditorOAdmin && secAccionesAuditor) {
                if (liq.estado === 1) { // Pendiente de auditoría
                    secAccionesAuditor.style.display = "flex";
                    if (tieneFacturas) {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                        contBotonVal.innerHTML = `
                            <form asp-action="Auditar" method="post" style="margin: 0; display: inline-block;">
                                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                                <input type="hidden" name="id" value="${liq.id}" />
                                <input type="hidden" name="nuevoEstado" value="2" />
                                <input type="hidden" name="observacion" value="Factura y remito conformados y validados conforme por Auditoría." />
                                <button type="submit" class="btn-lcp-primary btn-lcp-sm" style="background-color: #2B7A4B; border-color: #2B7A4B; font-weight: 700; padding: 6px 14px;">
                                    ✓ Confirmar y Validar Liquidación
                                </button>
                            </form>`;
                    } else {
                        contBotonVal.innerHTML = `
                            <button type="button" class="btn-lcp-outline btn-lcp-sm" style="opacity: 0.55; cursor: not-allowed; background-color: #F3F4F6; color: #9CA3AF; border-color: #D1D5DB; font-weight: 700; padding: 6px 14px;" onclick="alert('⚠️ ACCIÓN BLOQUEADA: La normativa contable exige que el Cliente o el Chofer carguen la factura comercial o remito antes de poder validar esta liquidación.')" title="Requiere factura comercial cargada por el cliente o chofer">
                                🔒 Validación Bloqueada (Falta Factura)
                            </button>`;
                    }
                } else {
                    secAccionesAuditor.style.display = "none";
                }
            } else if (contMsgCliente) {
                if (liq.estado === 1) {
                    contMsgCliente.innerHTML = `<span style="font-size: 12px; color: #946712; font-weight: 700; background: #FEF3C7; padding: 6px 14px; border-radius: 6px; border: 1px solid #FCD34D;">⏳ Pendiente de Auditoría y Dictamen Contable por Logística Centro País</span>`;
                } else if (liq.estado === 2) {
                    contMsgCliente.innerHTML = `<span style="font-size: 12px; color: #2B7A4B; font-weight: 700; background: #EBF8F0; padding: 6px 14px; border-radius: 6px; border: 1px solid #C3E6D0;">✓ Liquidación Auditada y Aprobada por Auditoría</span>`;
                } else if (liq.estado === 3) {
                    contMsgCliente.innerHTML = `<span style="font-size: 12px; color: #9D2424; font-weight: 700; background: #FBE8E8; padding: 6px 14px; border-radius: 6px; border: 1px solid #F3C7C7;">⚠️ Observada por Auditoría</span>`;
                }
            }

            document.getElementById("modalFichaLiquidacion").style.display = "flex";
        }

        function cerrarFichaLiquidacionModal() {
            document.getElementById("modalFichaLiquidacion").style.display = "none";
        }

        function togglePanelSubirFacturaModal() {
            const panel = document.getElementById("mflPanelSubirFactura");
            panel.style.display = panel.style.display === "none" ? "block" : "none";
        }

        function observarDesdeFichaModal() {
            cerrarFichaLiquidacionModal();
            observarLiquidacion(currentFichaLiqId, currentFichaLiqComp);
        }

        function abrirZoomImagenFactura(url, titulo) {
            document.getElementById("mzfImagenGrande").src = url;
            document.getElementById("mzfCaption").textContent = titulo || "Factura / Comprobante Comercial";
            document.getElementById("modalZoomImagenFactura").style.display = "flex";
        }

        function cerrarZoomImagenFactura() {
            document.getElementById("modalZoomImagenFactura").style.display = "none";
        }

        function observarLiquidacion(id, comprobante) {
            document.getElementById("modalLiqId").value = id;
            document.getElementById("modalObservarTitulo").textContent = `Observar Liquidación ${comprobante}`;
            document.getElementById("modalObservar").style.display = "flex";
        }
        function cerrarModalObservar() {
            document.getElementById("modalObservar").style.display = "none";
        }

        function abrirModalCargarFactura(id, comprobante) {
            document.getElementById("modalCargarLiqId").value = id;
            document.getElementById("modalCargarTitulo").textContent = `Cargar Factura: ${comprobante}`;
            document.getElementById("modalCargarFactura").style.display = "flex";
        }
        function cerrarModalCargarFactura() {
            document.getElementById("modalCargarFactura").style.display = "none";
        }

        async function verFacturas(id, comprobante, cliente) {
            abrirFichaLiquidacionModalPorId(id);
        }
    </script>
}
