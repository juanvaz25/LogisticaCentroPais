@model PostulacionChoferDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Alta de conductor - Logística Centro País";
}

<div style="max-width: 820px; margin: 40px auto; padding: 0 20px;">
    <div style="margin-bottom: 24px;">
        <a asp-action="Index" style="font-size: 13px; color: var(--lcp-primary); text-decoration: none; font-weight: 600;">← Volver al inicio</a>
        <h1 style="font-size: 28px; font-weight: 800; color: #192A33; margin: 12px 0 6px;">Alta de conductor</h1>
        <p style="font-size: 14px; color: #5F6B73; margin: 0;">
            Completá los datos y adjuntá la documentación. Revisaremos tu solicitud antes de activar tu cuenta. Los campos con * son obligatorios.
        </p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background-color: #FBE8E8; border: 1px solid #F3C7C7; color: #9D2424; padding: 12px 18px; border-radius: 6px; margin-bottom: 20px; font-size: 14px;">
            @Html.ValidationSummary(false)
        </div>
    }

    <form asp-action="PostulacionChofer" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- DATOS PERSONALES (PDF Página 9) -->
        <div class="lcp-card">
            <h2 class="lcp-card-title">Datos personales y contacto</h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Nombre *</label>
                    <input asp-for="Nombre" class="form-input" placeholder="Carlos" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Apellido *</label>
                    <input asp-for="Apellido" class="form-input" placeholder="Fernández" required />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Fecha de nacimiento *</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-input" required />
                </div>
                <div class="form-group">
                    <label class="form-label">CUIL *</label>
                    <input asp-for="CUIL" class="form-input" placeholder="20-33456789-3" required />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Celular / WhatsApp *</label>
                    <input asp-for="CelularWhatsApp" class="form-input" placeholder="+54 9 351 555-0148" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Correo electrónico *</label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="carlos.fernandez@correo.com" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Domicilio *</label>
                <input asp-for="Domicilio" class="form-input" placeholder="Av. Colón 1250" required />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Localidad *</label>
                    <input asp-for="Localidad" class="form-input" placeholder="Córdoba" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Provincia *</label>
                    <input asp-for="Provincia" class="form-input" placeholder="Córdoba" required />
                </div>
            </div>
        </div>

        <!-- DATOS DEL VEHÍCULO -->
        <div class="lcp-card">
            <h2 class="lcp-card-title">Datos del vehículo y carga</h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Patente camión</label>
                    <input asp-for="PatenteCamion" class="form-input" placeholder="AF 342 LK" />
                </div>
                <div class="form-group">
                    <label class="form-label">Capacidad de carga (kg)</label>
                    <input asp-for="CapacidadCargaKg" type="number" step="100" class="form-input" placeholder="14000" />
                </div>
                <div class="form-group">
                    <label class="form-label">Capacidad volumen (m³)</label>
                    <input asp-for="CapacidadVolumenM3" type="number" step="1" class="form-input" placeholder="60" />
                </div>
            </div>
        </div>

        <!-- DOCUMENTACIÓN (PDF Página 9) -->
        <div class="lcp-card">
            <h2 class="lcp-card-title">Documentación</h2>
            <p style="font-size: 13px; color: #5F6B73; margin-top: -10px; margin-bottom: 16px;">
                Fotos nítidas, completas y sin reflejos. JPG o PNG, hasta 10 MB por foto.
            </p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="form-group">
                    <label class="form-label">Licencia de conducir / LINTI (Frente y dorso)</label>
                    <input type="file" name="archivoLicencia" accept="image/*,.pdf" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label">Póliza de seguro del camión vigente</label>
                    <input type="file" name="archivoSeguro" accept="image/*,.pdf" class="form-input" />
                </div>
            </div>

            <div style="margin-top: 18px; display: flex; align-items: center; gap: 10px;">
                <input asp-for="DeclaracionJuradaAceptada" type="checkbox" id="dj" required style="width: 18px; height: 18px;" />
                <label for="dj" style="font-size: 13px; font-weight: 500; color: #192A33; cursor: pointer;">
                    Declaro que los datos y documentos son auténticos y autorizo su revisión.
                </label>
            </div>
        </div>

        <div style="margin-bottom: 60px;">
            <button type="submit" class="btn-lcp-primary" style="padding: 14px 28px; font-size: 15px;">
                Enviar documentación a revisión
            </button>
        </div>
    </form>
</div>
