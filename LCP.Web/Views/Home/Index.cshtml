    </section>

    <!-- 5. ARCHITECTURAL PILLARS (BLUEPRINT STYLE) -->
    <section class="landing-section-dark" id="arquitectura-operativa">
        <div class="section-container-max">
            <span class="section-tag-mono">ARQUITECTURA DE SERVICIOS LCP</span>
            <h2 class="section-title-mono" style="color: #FFFFFF;">
                Digitalización integral de la cadena de suministro.
            </h2>
            <p style="color: #94A3B8; max-width: 720px; font-size: 16px; margin: 0;">
                Diseñado para eliminar cuellos de botella en muelles, pérdidas de remitos y tiempos muertos entre transportistas y centros de acopio.
            </p>

            <div class="pillars-grid-mono">
                <div class="pillar-card-mono">
                    <span class="pillar-num">01 / PATIO & DÁRSENAS</span>
                    <h3 class="pillar-title">Gestión de Muelles</h3>
                    <p class="pillar-text">
                        Reserva exclusiva de dársenas para empresas cliente, turnos preasignados de arribo/despacho y liberación instantánea con pesaje digital verificado.
                    </p>
