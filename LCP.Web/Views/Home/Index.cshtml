    <!-- 3. INTERACTIVE CORRIDOR MATRIX (PERFECTLY ALIGNED COLUMNS) -->
    <section class="landing-section-dark" id="matriz-rutas">
        <div class="section-container-max">
            <span class="section-tag-mono">CONECTIVIDAD REGIONAL · ORIGEN Y DESTINO</span>
            <h2 class="section-title-mono" style="color: #FFFFFF;">
                La encrucijada del país: Rutas directas desde Santa Rosa.
            </h2>
            <p style="color: #94A3B8; max-width: 760px; font-size: 16px; margin: 0;">
                Seleccioná los corredores estratégicos para visualizar las distancias operativas, tipología de carga predominante y tiempos estimados de despacho desde el predio.
            </p>

            <div class="route-matrix-grid">
                <!-- Selector List (Stretches equally to match height) -->
                <div class="route-selector-list" id="routeSelectorList">
                    <div class="route-item-btn active" onclick="selectCorridor('caba', this)">
                        <div>
                            <div style="font-weight: 800; font-size: 16px;">Corredor Este · Buenos Aires (CABA / Puerto)</div>
                            <div style="font-size: 13px; opacity: 0.8; margin-top: 3px;">Ruta Nacional 5 directa · Sin pasos de montaña</div>
                        </div>
                        <span class="route-tag-pill">RN 5 · 615 KM</span>
                    </div>

                    <div class="route-item-btn" onclick="selectCorridor('bahia', this)">
                        <div>
                            <div style="font-weight: 800; font-size: 16px;">Corredor Sur · Bahía Blanca & Patagonia</div>
                            <div style="font-size: 13px; opacity: 0.8; margin-top: 3px;">Ruta Nacional 35 · Salida a terminal marítima de aguas profundas</div>
                        </div>
                        <span class="route-tag-pill">RN 35 · 330 KM</span>
                    </div>

                    <div class="route-item-btn" onclick="selectCorridor('neuquen', this)">
                        <div>
                            <div style="font-weight: 800; font-size: 16px;">Corredor Sudoeste · Neuquén / Vaca Muerta</div>
                            <div style="font-size: 13px; opacity: 0.8; margin-top: 3px;">Ruta Nacional 152 & 151 · Logística petrolera, insumos & químicas</div>
                        </div>
                        <span class="route-tag-pill">RN 152 · 540 KM</span>
                    </div>

                    <div class="route-item-btn" onclick="selectCorridor('cordoba', this)">
                        <div>
                            <div style="font-weight: 800; font-size: 16px;">Corredor Norte · Córdoba & Región Centro</div>
                            <div style="font-size: 13px; opacity: 0.8; margin-top: 3px;">Ruta Nacional 35 · Conexión agroindustrial y autopartes</div>
                        </div>
                        <span class="route-tag-pill">RN 35 · 605 KM</span>
                    </div>
                </div>

                <!-- Live Corridor Data Sheet Display (Aligned Height) -->
                <div class="route-detail-display" id="routeDataSheet">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #28333E; padding-bottom: 14px; margin-bottom: 16px;">
                            <span style="font-family: 'JetBrains Mono', Consolas, monospace; font-size: 13px; color: #94A3B8; text-transform: uppercase;">
                                FICHA TÉCNICA <span id="route-id-badge" style="color: #FFF; font-weight: 800;">#LCP-R01</span>
                            </span>
                            <span id="route-status-pill" style="font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12px; background: #25303B; color: #FFF; padding: 4px 10px; border-radius: 3px; font-weight: 700;">
                                TRÁNSITO HABILITADO
                            </span>
                        </div>

                        <h3 id="route-headline" style="font-size: 22px; font-weight: 800; color: #FFFFFF; margin: 0 0 10px;">
                            Santa Rosa (LP) ⇄ Buenos Aires (CABA / Puerto)
                        </h3>
                        <p id="route-narrative" style="font-size: 14.5px; color: #CBD5E1; line-height: 1.6; margin: 0 0 18px;">
                            Eje troncal de conexión con centros de consumo masivo, retail y terminales portuarias metropolitanas por Ruta Nacional 5 pasando por Pellegrini, Trenque Lauquen, Pehuajó, Nueve de Julio y Luján.
                        </p>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; font-family: 'JetBrains Mono', Consolas, monospace;">
                            <div style="background: #171F27; border: 1px solid #2B3846; padding: 12px 14px; border-radius: 4px;">
                                <span style="font-size: 11px; color: #94A3B8; display: block; font-weight: 600;">DISTANCIA TOTAL</span>
                                <strong id="route-metric-dist" style="font-size: 18px; color: #FFFFFF;">615 KM</strong>
                            </div>
                            <div style="background: #171F27; border: 1px solid #2B3846; padding: 12px 14px; border-radius: 4px;">
                                <span style="font-size: 11px; color: #94A3B8; display: block; font-weight: 600;">TIEMPO EN CAMIÓN</span>
                                <strong id="route-metric-time" style="font-size: 18px; color: #FFFFFF;">7.5 HORAS</strong>
                            </div>
                            <div style="background: #171F27; border: 1px solid #2B3846; padding: 12px 14px; border-radius: 4px;">
                                <span style="font-size: 11px; color: #94A3B8; display: block; font-weight: 600;">CARGA PREDOMINANTE</span>
                                <strong id="route-metric-type" style="font-size: 13px; color: #FFFFFF;">Consumo Masivo, Alimentos</strong>
                            </div>
                            <div style="background: #171F27; border: 1px solid #2B3846; padding: 12px 14px; border-radius: 4px;">
                                <span style="font-size: 11px; color: #94A3B8; display: block; font-weight: 600;">DOCUMENTACIÓN</span>
                                <strong id="route-metric-docs" style="font-size: 13px; color: #FFFFFF;">Remito Electrónico + Hoja</strong>
                            </div>
                        </div>
                    </div>

                    <div style="border-top: 1px solid #28333E; padding-top: 16px; margin-top: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                        <span style="font-size: 13px; color: #94A3B8;">
                            Despachos periódicos por este corredor:
                        </span>
                        <a asp-action="RegistroEmpresa" class="btn-lcp-monochrome" style="font-size: 13px; padding: 8px 16px;">
                            Solicitar Dársena o Despacho
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. LIVE DÁRSENAS HUD - CONCISE & ESSENTIAL INFO -->
    <section class="landing-section-light" id="darsenas-en-vivo">
        <div class="section-container-max">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
                <div>
                    <span class="section-tag-mono" style="color: #6C7A82;">PATIO & ALQUILERES</span>
                    <h2 class="section-title-mono" style="color: #192A33; margin: 0;">
                        Estado de las dársenas del predio.
                    </h2>
                </div>
                <div style="display: flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12px; background: #EAE6DF; border: 1px solid #D1CAC0; padding: 6px 14px; border-radius: 4px;">
                    <span class="signalr-pulse"></span>
                    <span style="font-weight: 700; color: #1E293B;">SignalR en vivo</span>
                </div>
            </div>

            <!-- Concise Dársenas Grid from Model -->
            <div class="darsenas-telemetry-grid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var d in Model)
                    {
                        var estaAlquilada = d.ClienteAlquilerActualId != null || !string.IsNullOrWhiteSpace(d.ClienteRazonSocial);
                        var isOcupada = d.EstadoActual == EstadoDarsena.Ocupada;
                        var isTurno = d.EstadoActual == EstadoDarsena.TurnoAsignado;

                        <div class="darsena-telemetry-card @(estaAlquilada ? "card-alquilada" : "card-libre-alquiler")">
                            <div>
                                <!-- Header: Darsena Name + Badges -->
                                <div class="darsena-card-head">
                                    <span class="darsena-card-title">@d.Codigo</span>

                                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                        @if (estaAlquilada)
                                        {
                                            <span class="badge-contrato-alquilada">Alquilada</span>
                                        }
                                        else
                                        {
                                            <span class="badge-contrato-disponible">Alquilable</span>
                                        }

                                        @if (isOcupada)
                                        {
                                            <span class="badge-muelle-ocupado">Camión en Muelle</span>
                                        }
                                        else if (isTurno)
                                        {
                                            <span class="badge-muelle-turno">Turno Asignado</span>
                                        }
                                        else
                                        {
                                            <span class="badge-muelle-libre">Muelle Libre</span>
                                        }
                                    </div>
                                </div>

                                <!-- Essential Info -->
                                <div style="font-size: 13.5px; color: #475569; margin-bottom: 12px;">
                                    @if (estaAlquilada)
                                    {
                                        <div>Inquilino: <strong style="color: #0F172A;">@d.ClienteRazonSocial</strong></div>
                                    }
                                    else
                                    {
                                        <div style="color: #15803D; font-weight: 700;">Habilitada para nuevo contrato de alquiler</div>
                                    }
                                </div>
                            </div>

                            <!-- Concise Capacity & Storage metrics -->
                            <div style="background: #F4F1EA; border: 1px solid #E2DDD5; border-radius: 4px; padding: 10px 14px; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12.5px;">
                                <div style="display: flex; justify-content: space-between;">
                                    <span style="color: #64748B;">Capacidad:</span>
                                    <strong style="color: #192A33;">@d.CapacidadMaximaM3 m³ · @d.CapacidadMaximaPallets pallets</strong>
                                </div>
                                @if (estaAlquilada)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 11.5px; color: #64748B; border-top: 1px dashed #DDD7CD; padding-top: 4px; margin-top: 4px;">
                                        <span>Ocupado: @d.VolumenOcupadoM3 m³</span>
                                        <span>Libre: <strong style="color: #192A33;">@d.VolumenDisponibleM3 m³</strong></span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @for (int i = 1; i <= 6; i++)
                    {
                        var isAlquiladaMock = i == 1 || i == 3;
                        <div class="darsena-telemetry-card @(isAlquiladaMock ? "card-alquilada" : "card-libre-alquiler")">
                            <div class="darsena-card-head">
                                <span class="darsena-card-title">Dársena @i</span>
                                <div style="display: flex; gap: 6px;">
                                    <span class="@(isAlquiladaMock ? "badge-contrato-alquilada" : "badge-contrato-disponible")">
