                        <text class="map-node-element" x="292" y="170" fill="#94A3B8" font-size="12" font-weight="600" font-family="Plus Jakarta Sans, sans-serif">Victorica</text>

                        <!-- Santa Rosa Central Hub Target -->
                        <g class="map-node-element" transform="translate(460, 240)">
                            <circle cx="0" cy="0" r="24" fill="none" stroke="#FFFFFF" stroke-width="1.5" class="radar-ping-ring" />
                            <circle cx="0" cy="0" r="12" fill="none" stroke="#FFFFFF" stroke-width="1.5" opacity="0.7" />
                            <circle cx="0" cy="0" r="6" fill="#FFFFFF" />
                            <circle cx="0" cy="0" r="2.5" fill="#0E1114" />
                            <line x1="-18" y1="0" x2="-8" y2="0" stroke="#FFFFFF" stroke-width="1.8" />
                            <line x1="8" y1="0" x2="18" y2="0" stroke="#FFFFFF" stroke-width="1.8" />
                            <line x1="0" y1="-18" x2="0" y2="-8" stroke="#FFFFFF" stroke-width="1.8" />
                            <line x1="0" y1="8" x2="0" y2="18" stroke="#FFFFFF" stroke-width="1.8" />

                            <rect x="-195" y="-36" width="185" height="30" rx="3" fill="#0E1114" stroke="#FFFFFF" stroke-width="1.5" />
                            <text x="-187" y="-16" fill="#FFFFFF" font-size="13" font-weight="800" font-family="Plus Jakarta Sans, sans-serif">SANTA ROSA [LCP NODO]</text>
                            <text x="-195" y="16" fill="#94A3B8" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">36°37'S 64°17'W · PREDIO BASE</text>
                        </g>
                    </g>

                    <!-- LCP Intro Badge (Morphs and dissolves into the map) -->
                    <g id="lcp-intro-badge">
                        <circle cx="470" cy="285" r="90" fill="none" stroke="#FFFFFF" stroke-width="1" opacity="0.25" />
                        <circle cx="470" cy="285" r="140" fill="none" stroke="#FFFFFF" stroke-width="0.8" opacity="0.15" />
                        
                        <rect x="360" y="240" width="220" height="90" rx="6" fill="#FFFFFF" stroke="#0E1114" stroke-width="3" />
                        <text x="470" y="302" fill="#0E1114" font-size="44" font-weight="900" font-family="Plus Jakarta Sans, sans-serif" text-anchor="middle" letter-spacing="4">LCP</text>
                        
                        <rect x="330" y="342" width="280" height="26" rx="3" fill="#141C24" stroke="#334155" stroke-width="1" />
                        <text x="470" y="359" fill="#E2E8F0" font-size="11.5" font-weight="700" font-family="JetBrains Mono, monospace" text-anchor="middle" letter-spacing="2">LOGÍSTICA CENTRO PAÍS</text>
                    </g>
                </svg>
            </div>
        </div>

        <!-- Bottom Telemetry Status & Enter Action -->
        <div class="intro-bottom-bar">
            <div class="intro-phase-tracker">
                <div class="phase-step active" id="phase-1">
                    <span class="phase-dot"></span>
                    <span>1. IDENTIDAD LCP</span>
                </div>
                <div class="phase-step" id="phase-2">
                    <span class="phase-dot"></span>
                    <span>2. CARTOGRAFÍA LA PAMPA</span>
                </div>
                <div class="phase-step" id="phase-3">
                    <span class="phase-dot"></span>
                    <span>3. CORREDORES HABILITADOS</span>
                </div>
            </div>

            <button type="button" class="btn-intro-enter" onclick="dismissIntro()">
                <span>Entrar a la Plataforma</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>

        <!-- Dynamic Timeline Line -->
        <div id="intro-progress-bar" class="intro-progress-line"></div>
    </div>

<div class="landing-wrap">

    <!-- 1. TECHNICAL MONOCHROME NAV -->
    <header class="lcp-landing-bar">
        <div style="display: flex; align-items: center; gap: 18px;">
            <a href="/" class="lcp-landing-logo">
                <span class="lcp-brand-tag">LCP</span>
                <span style="font-weight: 800; font-size: 16px; letter-spacing: -0.3px; color: #FFFFFF;">Logística Centro País</span>
            </a>
            <div class="lcp-landing-coords">
                36°37′00″S 64°17′00″W · HUB PAMPA CENTRAL
            </div>
        </div>

        <nav class="lcp-landing-links">
            <a href="#nodo-estrategico">Nodo Central</a>
            <a href="#matriz-rutas">Rutas & Envíos</a>
            <a href="#darsenas-en-vivo">Dársenas</a>
            <a href="#arquitectura-operativa">Servicios</a>
            <button type="button" onclick="openFullscreenIntro()" class="btn-lcp-ghost-mono" style="font-size: 12px; padding: 6px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;" title="Ver introducción animada en pantalla completa">
                ↺ Ver Intro
            </button>
            <a asp-controller="Auth" asp-action="Login" class="btn-lcp-monochrome">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Ingresar al Sistema
            </a>
        </nav>
    </header>

    <!-- 2. HERO: CENTRALIZED EDITORIAL & EXACT 2D MAP OF LA PAMPA WITH LOGO INTRO TRANSFORMATION -->
    <section class="hero-editorial" id="nodo-estrategico">
        <!-- Headline & Value Proposition -->
        <div class="hero-editorial-top">
            <div class="hero-pill-tech">
                <span class="dot"></span>
                <span>Infraestructura Física & Telemática · Santa Rosa, La Pampa</span>
            </div>

            <h1 class="hero-editorial-title">
                El centro neurálgico del transporte terrestre argentino.
            </h1>

            <p class="hero-editorial-desc">
                La Pampa es el vértice natural de convergencia entre Buenos Aires, los puertos de aguas profundas, Cuyo y la cuenca de Vaca Muerta. Centralizamos el patio de maniobras, dársenas dedicadas por empresa y la trazabilidad de envíos en tiempo real.
            </p>

            <div class="hero-actions">
                <a asp-action="RegistroEmpresa" class="btn-lcp-monochrome" style="font-size: 15px; padding: 12px 24px;">
                    Registrar Empresa Cliente
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a asp-action="PostulacionChofer" class="btn-lcp-ghost-mono" style="font-size: 15px; padding: 12px 24px;">
                    Postulación de Transportistas
                </a>
            </div>

            <!-- CORPORATE CLIENTS CAROUSEL (EMPRESAS SATISFECHAS) -->
