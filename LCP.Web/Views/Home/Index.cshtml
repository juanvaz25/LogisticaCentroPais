@model List<DarsenaDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "LCP · Nodo Logístico Centro del País | Santa Rosa, La Pampa";
}

    <!-- ========================================================================= -->
    <!-- CINEMATIC FULLSCREEN INTRO: LCP LOGO MORPHING INTO LA PAMPA 2D MAP        -->
    <!-- Opens first on page load, runs full sequence, then smoothly reveals landing-->
    <!-- ========================================================================= -->
    <div id="lcp-fullscreen-intro">
        <script>
            // Si ya se ejecutó la animación en una visita anterior, ocultar inmediatamente sin parpadeos
            (function() {
                try {
                    if (localStorage.getItem('lcp_intro_shown')) {
                        var introEl = document.getElementById('lcp-fullscreen-intro');
                        if (introEl) {
                            introEl.classList.add('intro-dismissed');
                            introEl.style.display = 'none';
                        }
                    }
                } catch(e) {}
            })();
        </script>
        <!-- Top Telemetry & Skip Control -->
        <div class="intro-top-bar">
            <div class="intro-brand-box">
                <span class="intro-brand-badge">LCP</span>
                <span class="intro-brand-text">LOGÍSTICA CENTRO PAÍS · HUB PAMPA CENTRAL</span>
            </div>
            <div class="intro-top-meta">
                <span class="intro-coords">36°37′00″S 64°17′00″W · SANTA ROSA, LA PAMPA</span>
                <button type="button" class="btn-intro-skip" onclick="dismissIntro()" title="Omitir animación y entrar directamente">
                    Saltar Intro [ESC] ✕
                </button>
            </div>
        </div>

        <!-- Center Stage: Scaled Cartographic SVG Canvas -->
        <div class="intro-center-stage">
            <div class="intro-svg-wrapper">
                <svg id="pampa-intro-map" class="intro-animating" viewBox="0 0 940 600" style="width: 100%; height: auto; max-height: 65vh;" preserveAspectRatio="xMidYMid meet">
