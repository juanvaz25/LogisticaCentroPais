<!-- SCRIPT FOR INTRO TRANSFORMATION & INTERACTIVE CORRIDOR MATRIX -->
<script>
    // Fullscreen Intro Controller
    let introTimer = null;
    let phaseTimers = [];

    function dismissIntro() {
        try {
            localStorage.setItem('lcp_intro_shown', 'true');
        } catch (e) {}

        const introElem = document.getElementById('lcp-fullscreen-intro');
        if (introElem) {
            introElem.classList.add('intro-dismissed');
            setTimeout(() => {
                if (introElem.classList.contains('intro-dismissed')) {
                    introElem.style.display = 'none';
                }
            }, 800);
        }
        document.body.classList.remove('intro-locked');
        if (introTimer) clearTimeout(introTimer);
        phaseTimers.forEach(t => clearTimeout(t));
        phaseTimers = [];
    }

    function openFullscreenIntro() {
        const introElem = document.getElementById('lcp-fullscreen-intro');
        const progressBar = document.getElementById('intro-progress-bar');
        const mapSvg = document.getElementById('pampa-intro-map');
        if (!introElem) return;

        // Mostrar elemento si estaba oculto
        introElem.style.display = 'flex';
        void introElem.offsetWidth; // Forzar reflow

        // Clear ongoing timers
        if (introTimer) clearTimeout(introTimer);
        phaseTimers.forEach(t => clearTimeout(t));
        phaseTimers = [];

        // Lock body scrolling and show fullscreen overlay
        document.body.classList.add('intro-locked');
        introElem.classList.remove('intro-dismissed');

        // Reset phases indicator
        const p1 = document.getElementById('phase-1');
        const p2 = document.getElementById('phase-2');
        const p3 = document.getElementById('phase-3');
        if (p1) p1.classList.add('active');
        if (p2) p2.classList.remove('active');
        if (p3) p3.classList.remove('active');

        // Reset progress bar animation
        if (progressBar) {
            progressBar.style.transition = 'none';
            progressBar.style.width = '0%';
            void progressBar.offsetWidth; // Force reflow
            progressBar.style.transition = 'width 3.6s linear';
            progressBar.style.width = '100%';
        }

        // Restart SVG animations
        if (mapSvg) {
            mapSvg.classList.remove('intro-animating');
            void mapSvg.offsetWidth;
            mapSvg.classList.add('intro-animating');
        }

        // Phase progression schedule
        phaseTimers.push(setTimeout(() => {
            if (p2) p2.classList.add('active');
        }, 1200));

        phaseTimers.push(setTimeout(() => {
            if (p3) p3.classList.add('active');
        }, 2200));

        // Auto transition into the landing page after 3.8s
        introTimer = setTimeout(() => {
            dismissIntro();
        }, 3800);
    }

    // Keyboard shortcut: ESC to dismiss immediately
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            dismissIntro();
        }
    });

    // ==========================================
    // CORPORATE CLIENTS CAROUSEL CONTROLLER
    // ==========================================
    let currentClientSlide = 0;
    let clientAutoplayTimer = null;

    function getVisibleCardsCount() {
        return window.innerWidth <= 900 ? 1 : 2;
    }

    function getMaxClientSlides() {
        const totalCards = document.querySelectorAll('.corporate-client-card').length;
        const visible = getVisibleCardsCount();
        return Math.max(0, totalCards - visible);
    }

    function updateClientCarousel() {
        const track = document.getElementById('clientsCarouselTrack');
        const dotsContainer = document.getElementById('clientsCarouselDots');
        if (!track) return;

        const visible = getVisibleCardsCount();
        const totalCards = document.querySelectorAll('.corporate-client-card').length;
        const maxSlides = Math.max(0, totalCards - visible);

        if (currentClientSlide > maxSlides) {
            currentClientSlide = 0;
        }

        const stepPercentage = 100 / visible;
        track.style.transform = `translateX(-${currentClientSlide * stepPercentage}%)`;

        // Update dots
        if (dotsContainer) {
            const totalDots = maxSlides + 1;
            let dotsHtml = '';
            for (let i = 0; i < totalDots; i++) {
                dotsHtml += `<button type="button" class="carousel-dot ${i === currentClientSlide ? 'active' : ''}" onclick="goToClientSlide(${i})" aria-label="Ir a diapositiva ${i + 1}"></button>`;
            }
            dotsContainer.innerHTML = dotsHtml;
        }
    }

    function nextClientSlide() {
        const maxSlides = getMaxClientSlides();
        if (currentClientSlide >= maxSlides) {
            currentClientSlide = 0;
        } else {
            currentClientSlide++;
        }
        updateClientCarousel();
    }

    function prevClientSlide() {
        const maxSlides = getMaxClientSlides();
        if (currentClientSlide <= 0) {
            currentClientSlide = maxSlides;
        } else {
            currentClientSlide--;
        }
        updateClientCarousel();
    }

    function goToClientSlide(index) {
        currentClientSlide = index;
        updateClientCarousel();
    }

    function pauseClientCarousel() {
        if (clientAutoplayTimer) {
            clearInterval(clientAutoplayTimer);
            clientAutoplayTimer = null;
        }
    }

    function resumeClientCarousel() {
        pauseClientCarousel();
        clientAutoplayTimer = setInterval(() => {
            nextClientSlide();
        }, 5500);
    }

    function initClientCarousel() {
        updateClientCarousel();
        resumeClientCarousel();
    }

    window.addEventListener('resize', () => {
        updateClientCarousel();
    });

    // Auto-launch fullscreen intro sólo la primera vez; iniciar carrusel corporativo
    document.addEventListener('DOMContentLoaded', () => {
        let hasSeenIntro = false;
        try {
            hasSeenIntro = !!localStorage.getItem('lcp_intro_shown');
        } catch (e) {}

        if (!hasSeenIntro) {
            try {
                localStorage.setItem('lcp_intro_shown', 'true');
            } catch (e) {}
            openFullscreenIntro();
        } else {
            dismissIntro();
        }

        initClientCarousel();
    });

    // Corridors Data Matrix
    const corridorsData = {
        'caba': {
            id: '#LCP-R01',
            status: 'TRÁNSITO HABILITADO',
            headline: 'Santa Rosa (LP) ⇄ Buenos Aires (CABA / Puerto)',
            narrative: 'Eje troncal de conexión con centros de consumo masivo, retail y terminales portuarias metropolitanas por Ruta Nacional 5 pasando por Pellegrini, Trenque Lauquen, Pehuajó, Nueve de Julio y Luján.',
            dist: '615 KM',
            time: '7.5 HORAS',
            type: 'Consumo Masivo, Alimentos',
            docs: 'Remito Electrónico + Hoja',
            routeElemId: 'route-rn5'
        },
        'bahia': {
            id: '#LCP-R02',
            status: 'CONEXIÓN MARÍTIMA ACTIVA',
            headline: 'Santa Rosa (LP) ⇄ Puerto Bahía Blanca & Ing. White',
            narrative: 'Salida directa a terminal de aguas profundas del Atlántico Sur. Crucial para graneles agrícolas, fertilizantes y transferencia multimodal hacia la Patagonia.',
            dist: '330 KM',
            time: '4.2 HORAS',
            type: 'Granos, Fertilizantes, Exportación',
            docs: 'Carta Porte Automotor + Remito',
            routeElemId: 'route-rn35'
        },
        'neuquen': {
            id: '#LCP-R03',
            status: 'CORREDOR ENERGÉTICO EN EXPANSIÓN',
            headline: 'Santa Rosa (LP) ⇄ Neuquén Capital & Vaca Muerta',
            narrative: 'Abastecimiento continuo de la industria hidrocarburífera no convencional por Ruta Nacional 152 pasando por General Acha, Puelches y empalme RN 151.',
            dist: '540 KM',
            time: '6.8 HORAS',
            type: 'Arenas, Tubos, Químicos, Insumos Oil & Gas',
            docs: 'Guía de Tránsito + Certificados',
            routeElemId: 'route-rn152'
        },
        'cordoba': {
            id: '#LCP-R04',
            status: 'CONEXIÓN AGROINDUSTRIAL',
            headline: 'Santa Rosa (LP) ⇄ Córdoba Capital & Eje Centro',
            narrative: 'Conecta con el polo metalmecánico y autopartista del centro del país a través de RN 35 hacia el norte, cruzando Eduardo Castex, Realicó y Río Cuarto.',
            dist: '605 KM',
            time: '7.2 HORAS',
            type: 'Maquinaria Agrícola, Repuestos',
            docs: 'Remito Electrónico + Inspección',
            routeElemId: 'route-rn35'
        }
    };

    function selectCorridor(key, buttonElem) {
        // Update active class on buttons
        const allButtons = document.querySelectorAll('#routeSelectorList .route-item-btn');
        allButtons.forEach(btn => btn.classList.remove('active'));
        if (buttonElem) buttonElem.classList.add('active');

        const data = corridorsData[key];
        if (!data) return;

        // Update technical datasheet display
        document.getElementById('route-id-badge').textContent = data.id;
        document.getElementById('route-status-pill').textContent = data.status;
        document.getElementById('route-headline').textContent = data.headline;
        document.getElementById('route-narrative').textContent = data.narrative;
        document.getElementById('route-metric-dist').textContent = data.dist;
        document.getElementById('route-metric-time').textContent = data.time;
        document.getElementById('route-metric-type').textContent = data.type;
        document.getElementById('route-metric-docs').textContent = data.docs;

        // Highlight corresponding 2D SVG vector route
        const allRoutes = ['route-rn5', 'route-rn35', 'route-rn152'];
        allRoutes.forEach(rId => {
            const el = document.getElementById(rId);
            if (el) {
                if (rId === data.routeElemId) {
                    el.setAttribute('stroke', '#FFFFFF');
                    el.setAttribute('stroke-width', '4');
                } else {
                    el.setAttribute('stroke', '#94A3B8');
                    el.setAttribute('stroke-width', '2.5');
                }
            }
        });
    }
</script>
