                            <text x="12" y="15" fill="#E2E8F0" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">RN 188</text>
                        </g>

                        <line class="map-route-line" x1="460" y1="0" x2="460" y2="560" stroke="#94A3B8" stroke-width="2.5" stroke-dasharray="6 4" />
                        <g class="map-node-element" transform="translate(385, 129)">
