                        <line class="map-node-element" x1="85" y1="340" x2="540" y2="340" stroke="#1F2C38" stroke-width="1.2" stroke-dasharray="4,4" />
                        <line class="map-node-element" x1="380" y1="118" x2="380" y2="478" stroke="#1F2C38" stroke-width="1.2" stroke-dasharray="4,4" />

