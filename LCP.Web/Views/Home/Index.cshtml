                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#18222C" stroke-width="0.8" />
                        </pattern>
                    </defs>

                    <!-- Background Grid -->
                    <rect width="940" height="600" fill="url(#grid-intro)" opacity="0.8" />

                    <!-- Destinations -->
                    <g class="map-dest-card" transform="translate(530, 16)">
                        <rect x="0" y="0" width="220" height="28" rx="3" fill="#141C24" stroke="#2B3846" stroke-width="1.2" />
                        <text x="12" y="19" fill="#CBD5E1" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">▲ CÓRDOBA / SAN LUIS (RN 35)</text>
                    </g>

                    <g class="map-dest-card" transform="translate(735, 195)">
                        <rect x="0" y="0" width="185" height="42" rx="4" fill="#141C24" stroke="#38495A" stroke-width="1.4" />
                        <text x="14" y="20" fill="#FFFFFF" font-size="14" font-weight="800" font-family="Plus Jakarta Sans, sans-serif" letter-spacing="0.5">BUENOS AIRES ➔</text>
                        <text x="14" y="34" fill="#94A3B8" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">RN 5 · 615 KM</text>
                    </g>

                    <g class="map-dest-card" transform="translate(480, 560)">
