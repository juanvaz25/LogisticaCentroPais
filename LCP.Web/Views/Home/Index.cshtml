    </section>

    <!-- 6. HIGH-CONTRAST CALL TO ACTION (CLIENTE / CHOFER) -->
    <section class="landing-section-light">
        <div class="section-container-max">
            <div style="text-align: center; max-width: 780px; margin: 0 auto 40px;">
                <span class="section-tag-mono" style="color: #6C7A82;">ACCESO FORMAL AL NODO</span>
