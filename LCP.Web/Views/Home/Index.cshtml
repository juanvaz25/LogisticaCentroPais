                    </g>

                    <g class="map-dest-card" transform="translate(35, 460)">
                        <rect x="0" y="0" width="235" height="28" rx="3" fill="#141C24" stroke="#2B3846" stroke-width="1.2" />
                        <text x="12" y="19" fill="#CBD5E1" font-size="12" font-weight="700" font-family="JetBrains Mono, monospace">◀ NEUQUÉN / VACA MUERTA (RN 152)</text>
