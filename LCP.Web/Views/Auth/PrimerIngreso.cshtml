@model CambiarPasswordDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Primer Ingreso · Cambio Obligatorio de Contraseña - LCP";
}

<div style="min-height: calc(100vh - 180px); display: flex; align-items: center; justify-content: center; padding: 40px 20px; background-color: #07090C;">
    <div style="width: 100%; max-width: 520px; background: #0E1217; border: 1px solid #1E2732; border-radius: 8px; padding: 36px 32px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6); color: #FFFFFF;">
        
        <!-- Header Badge -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #1C2530; padding-bottom: 14px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="background: #FFFFFF; color: #07090C; font-weight: 900; font-size: 12px; padding: 3px 8px; border-radius: 3px; letter-spacing: 1px;">LCP</span>
                <span style="font-weight: 700; font-size: 13px; color: #E2E8F0;">SEGURIDAD OPERACIONAL</span>
            </div>
            <span style="font-family: 'JetBrains Mono', Consolas, monospace; font-size: 11px; color: #64748B;">
                PRIMER INGRESO
            </span>
        </div>

        <h1 style="font-size: 22px; font-weight: 800; color: #FFFFFF; letter-spacing: -0.4px; margin: 0 0 10px; line-height: 1.3;">
            Establecer Contraseña Definitiva
        </h1>

        <p style="font-size: 13.5px; color: #94A3B8; line-height: 1.5; margin: 0 0 24px;">
            Por políticas de ciberseguridad del predio logístico, es obligatorio cambiar la contraseña provisoria antes de acceder a tus dársenas y operaciones.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background-color: #2D1414; border: 1px solid #7F1D1D; color: #FCA5A5; padding: 12px 16px; border-radius: 4px; margin-bottom: 20px; font-size: 13px;">
                @Html.ValidationSummary(false)
            </div>
        }

        <form asp-action="PrimerIngreso" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group" style="margin-bottom: 18px;">
                <label style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #CBD5E1; margin-bottom: 6px;">
                    Contraseña actual (provisoria) *
                </label>
                <input asp-for="PasswordActual" type="password" class="form-input" placeholder="Ingresá la contraseña actual" required 
                       style="background: #141A22; border: 1px solid #2B3846; color: #FFFFFF; width: 100%; padding: 12px 14px; border-radius: 4px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="PasswordActual" style="color: #F87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #CBD5E1; margin-bottom: 6px;">
                    Nueva contraseña definitiva *
                </label>
                <input asp-for="PasswordNuevo" type="password" class="form-input" placeholder="Mínimo 6 caracteres" required 
                       style="background: #141A22; border: 1px solid #2B3846; color: #FFFFFF; width: 100%; padding: 12px 14px; border-radius: 4px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="PasswordNuevo" style="color: #F87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label style="display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #CBD5E1; margin-bottom: 6px;">
                    Confirmar nueva contraseña *
                </label>
                <input asp-for="ConfirmarPassword" type="password" class="form-input" placeholder="Repetí la nueva contraseña" required 
                       style="background: #141A22; border: 1px solid #2B3846; color: #FFFFFF; width: 100%; padding: 12px 14px; border-radius: 4px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="ConfirmarPassword" style="color: #F87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 28px;">
                <button type="submit" class="btn-lcp-monochrome" style="width: 100%; padding: 13px; font-size: 14.5px; font-weight: 800; cursor: pointer; text-align: center; border: none; border-radius: 4px;">
                    Guardar Contraseña Definitiva ➔
                </button>
            </div>
        </form>

        <div style="margin-top: 24px; text-align: center; border-top: 1px solid #1C2530; padding-top: 18px;">
            <form asp-action="Logout" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" style="background: none; border: none; color: #64748B; font-size: 13px; cursor: pointer; text-decoration: underline;">
                    ← Cancelar y cerrar sesión
                </button>
            </form>
        </div>

    </div>
</div>
