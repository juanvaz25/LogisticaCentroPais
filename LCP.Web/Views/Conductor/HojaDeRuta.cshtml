@model SolicitudOperacionDto
@{
    ViewData["Title"] = $"Hoja de Ruta #{Model.CodigoSolicitud} - Logística Centro País";

    var estadoViaje = Model.EstadoViaje ?? EstadoViaje.Asignado;
    bool esDoble = Model.EsDobleViaje;
    bool esDespacho = Model.TipoOperacion == TipoOperacionSolicitud.DespachoRetiro;
    bool esConductor = User.IsInRole(Roles.Conductor);
    string ciudadCliente = !string.IsNullOrEmpty(Model.CiudadDestino) && !Model.CiudadDestino.Contains("Santa Rosa")
        ? Model.CiudadDestino
        : (!string.IsNullOrEmpty(Model.CiudadOrigen) && !Model.CiudadOrigen.Contains("Santa Rosa") ? Model.CiudadOrigen : "Buenos Aires (CABA)");

    decimal kmTramo = Model.DistanciaEstimadaKm > 0 ? Model.DistanciaEstimadaKm : 615;
    decimal kmTotales = esDoble ? kmTramo * 2 : kmTramo;

    var hitoActual = Model.ViajeInfo?.ObservacionesChofer ?? "";
    int pasoDobleActual = 1;
    if (Model.Estado == EstadoSolicitud.Completada || estadoViaje == EstadoViaje.DescargadoCompletado)
    {
        pasoDobleActual = 6;
    }
    else if (hitoActual.Contains("Paso 5") || estadoViaje == EstadoViaje.EnPredioDarsena)
    {
        // En Guardado / Ingreso: Chofer ya reportó llegada a LCP (Paso 5). El paso activo en curso es el Paso 6 (descarga del operador)
        pasoDobleActual = 6;
    }
    else if (hitoActual.Contains("Paso 4"))
    {
        // Chofer en retorno: el siguiente hito activo a presionar es el Paso 5
        pasoDobleActual = 5;
    }
    else if (hitoActual.Contains("Paso 3"))
    {
        // Chofer cargó en cliente: el siguiente hito activo es el Paso 4 (retorno)
        pasoDobleActual = 4;
    }
    else if (hitoActual.Contains("Paso 2"))
    {
        // Chofer llegó a cliente: el siguiente hito activo es el Paso 3 (carga)
        pasoDobleActual = 3;
    }
    else if (hitoActual.Contains("Paso 1") || estadoViaje == EstadoViaje.EnRuta)
    {
        // Chofer salió a ruta: el siguiente hito activo es el Paso 2 (llegada cliente)
        pasoDobleActual = 2;
    }
    else
    {
        pasoDobleActual = 1;
    }

    int pasoPropioActual = 1;
    if (esDespacho)
    {
        if (Model.Estado == EstadoSolicitud.Completada || estadoViaje == EstadoViaje.DescargadoCompletado || hitoActual.Contains("Paso 4"))
        {
            pasoPropioActual = 5;
        }
        else if (hitoActual.Contains("Paso 3") || (estadoViaje == EstadoViaje.EnRuta && (hitoActual.Contains("tránsito") || hitoActual.Contains("transito"))))
        {
            pasoPropioActual = 4;
        }
        else if (hitoActual.Contains("Paso 2") || (estadoViaje == EstadoViaje.EnRuta && hitoActual.Contains("despachado")))
        {
            pasoPropioActual = 3;
        }
        else if (estadoViaje >= EstadoViaje.EnPredioDarsena || hitoActual.Contains("Paso 1"))
        {
            pasoPropioActual = 2;
        }
        else
        {
            pasoPropioActual = 1;
        }
    }
    else
    {
        if (Model.Estado == EstadoSolicitud.Completada || estadoViaje == EstadoViaje.DescargadoCompletado || hitoActual.Contains("Paso 4"))
        {
            pasoPropioActual = 5;
        }
        else if (estadoViaje >= EstadoViaje.EnPredioDarsena || hitoActual.Contains("Paso 3") || hitoActual.Contains("Arrib") || hitoActual.Contains("Calle San Martín"))
        {
            pasoPropioActual = 4;
        }
        else if (hitoActual.Contains("Paso 2") || (estadoViaje == EstadoViaje.EnRuta && (hitoActual.Contains("tránsito") || hitoActual.Contains("transito"))))
        {
            pasoPropioActual = 3;
        }
        else if (estadoViaje >= EstadoViaje.EnRuta || hitoActual.Contains("Paso 1"))
        {
            pasoPropioActual = 2;
        }
        else
        {
            pasoPropioActual = 1;
        }
    }
}

<!-- LEAFLET CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
    <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            @if (esConductor)
            {
                <a asp-action="Index" style="color: var(--lcp-primary); text-decoration: none; font-size: 13px; font-weight: 700;">
                    ⬅ Volver a Mis Viajes
                </a>
            }
            else
            {
                <a asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@Model.Id" style="color: var(--lcp-primary); text-decoration: none; font-size: 13px; font-weight: 700;">
                    ⬅ Volver al Detalle de Solicitud
                </a>
            }
            <span style="color: var(--lcp-text-muted);">/</span>
            <span style="font-size: 13px; color: var(--lcp-text-muted);">Hoja de Ruta Oficial</span>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
            <h1 class="page-title" style="margin: 0;">Hoja de Ruta @Model.CodigoSolicitud</h1>
            <span class="badge-estado @(Model.Estado == EstadoSolicitud.EnCurso ? "badge-encurso" : (Model.Estado == EstadoSolicitud.Completada ? "badge-completada" : "badge-programada"))" style="font-size: 13px; padding: 4px 12px;">
                @Model.EstadoNombre
            </span>
            <span id="badgeEstadoViajeVivo" style="background-color: #162E3B; color: #FFF; font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">
                Viaje: @estadoViaje.ToString()
            </span>
        </div>
        <p class="page-subtitle" style="margin-top: 6px;">
            Cliente: <strong>@Model.ClienteRazonSocial</strong> · Operación: <strong>@Model.TipoOperacionNombre</strong> · Dársena: <strong>@Model.DarsenaCodigo</strong>
        </p>
    </div>

    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        @if (esConductor)
        {
            <button type="button" class="btn-lcp-outline btn-lcp-sm" style="border-color: #C0392B; color: #C0392B;" onclick="abrirModalIncidente()">
                🚨 Reportar Demora / Incidente
            </button>
        }
        <a asp-controller="Inbox" asp-action="Index" class="btn-lcp-outline btn-lcp-sm">
            💬 Chat con Operador y Cliente
        </a>
        <a asp-controller="Solicitudes" asp-action="Detalle" asp-route-id="@Model.Id" class="btn-lcp-outline btn-lcp-sm">
            📄 Ficha Completa
        </a>
    </div>
</div>

<!-- BANNER DE MODALIDAD (DOBLE VIAJE FLOTA LCP vs VIAJE SIMPLE CHOFER PROPIO) -->
@if (esDoble)
{
    <div class="lcp-card" style="background: linear-gradient(135deg, #1A3644 0%, #28536B 100%); color: #FFFFFF; border: none; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 4px 18px rgba(22, 46, 59, 0.15);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                    <span style="font-size: 22px;">🔁</span>
                    <span style="font-size: 17px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #FFD54F;">
                        DOBLE VIAJE - FLOTA LCP (Ida y Vuelta)
                    </span>
                    <span style="background-color: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                        Unidad Oficial Asignada
                    </span>
                </div>
                <p style="font-size: 13px; color: #E0EBF0; margin: 0; line-height: 1.6; max-width: 820px;">
                    Como conductor designado de <strong>Flota LCP</strong>, esta misión contempla el circuito de <strong>doble viaje</strong>: Salida desde la base central en Santa Rosa cargado con los productos del cliente almacenados en <strong>@Model.DarsenaCodigo</strong> rumbo a <strong>@ciudadCliente</strong> para despachar y entregar la mercadería, y posterior retorno por carretera hacia la Base LCP completando la misión.
                </p>
            </div>
            <div style="background-color: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 12px 18px; text-align: right;">
                <div style="font-size: 11px; text-transform: uppercase; color: #ADC2CE; font-weight: 700;">Distancia Total Circuito</div>
                <div style="font-size: 24px; font-weight: 800; color: #FFFFFF;">
                    @kmTotales.ToString("N0") km
                </div>
                <div style="font-size: 11px; color: #A5D6A7; font-weight: 600;">
                    (@kmTramo.ToString("N0") km ida + @kmTramo.ToString("N0") km vuelta)
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="lcp-card" style="background: linear-gradient(135deg, #1E462E 0%, #2B7A4B 100%); color: #FFFFFF; border: none; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 4px 18px rgba(30, 70, 46, 0.15);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                    <span style="font-size: 22px;">➡️</span>
                    <span style="font-size: 17px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: #A5D6A7;">
                        VIAJE SIMPLE DIRECTO - CHOFER PROPIO
                    </span>
                    <span style="background-color: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                        Transporte del Cliente
                    </span>
                </div>
                <p style="font-size: 13px; color: #E0EBF0; margin: 0; line-height: 1.6; max-width: 820px;">
                    Operación con <strong>camión propio del cliente</strong>. El viaje comprende un único tramo carretero directo desde <strong>@ciudadCliente</strong> hacia el nodo logístico de Santa Rosa para ingresar por <strong>Calle San Martín 245</strong> hacia la <strong>@Model.DarsenaCodigo</strong>.
                </p>
            </div>
            <div style="background-color: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 12px 18px; text-align: right;">
                <div style="font-size: 11px; text-transform: uppercase; color: #ADC2CE; font-weight: 700;">Distancia Directa</div>
                <div style="font-size: 24px; font-weight: 800; color: #FFFFFF;">
                    @kmTramo.ToString("N0") km
                </div>
                <div style="font-size: 11px; color: #A5D6A7; font-weight: 600;">
                    Tramo único carretero
                </div>
            </div>
        </div>
    </div>
}

<!-- MAIN GRID: CHECKLIST & ITINERARIO A LA IZQUIERDA, MAPA LEAFLET A LA DERECHA -->
<div style="display: grid; grid-template-columns: 1fr 1.35fr; gap: 24px; align-items: start;">

    <!-- COLUMNA IZQUIERDA: CHECKLIST DE TAREAS Y ACCIONES RÁPIDAS -->
    <div style="display: flex; flex-direction: column; gap: 20px;">

        <!-- STEPPER INTERACTIVO DE HITOS -->
        <div class="lcp-card" style="margin: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <h2 class="lcp-card-title" style="margin: 0;">📋 Cronograma de Tareas en Ruta</h2>
                <span style="font-size: 11px; color: var(--lcp-text-muted); font-weight: 700;">ACTUALIZACIÓN EN VIVO</span>
            </div>

            @if (esConductor)
            {
                <p style="font-size: 12px; color: var(--lcp-text-muted); margin: 0 0 16px;">
                    Tocá cada botón a medida que cumplas cada etapa del viaje para mantener informados al Operador de Patio y al Cliente.
                </p>
            }
            else
            {
                <div style="background-color: #E8F4F8; border-left: 4px solid var(--lcp-primary); padding: 12px 14px; border-radius: 4px; margin-bottom: 16px; font-size: 12.5px; color: #162E3B; line-height: 1.5;">
                    <strong>👁️ Modo Monitoreo / Solo Lectura (Operador de Patio):</strong>
                    Visualización del itinerario y avance de la unidad en tiempo real. Los pasos e hitos carreteros son reportados exclusivamente por el conductor asignado a la unidad desde su dispositivo.
                </div>
            }

            <div class="milestones-container" style="display: flex; flex-direction: column; gap: 14px;">
                @if (esDoble && !esDespacho)
                {
                    <!-- FLOTA LCP: GUARDADO / INGRESO DE STOCK (CIRCUITO COMPLETO DOBLE VIAJE) -->
                    <!-- PASO 1: SALIDA DESDE BASE LCP HACIA EL CLIENTE -->
                    <div class="milestone-box @(pasoDobleActual > 1 ? "milestone-done" : (pasoDobleActual == 1 ? "milestone-current" : "milestone-pending"))" id="stepFlota1">
                        <div class="milestone-icon">@(pasoDobleActual > 1 ? "✓" : "1")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">1. Salida hacia @ciudadCliente</div>
                            <div class="milestone-desc">Partida con camión desde Base Central LCP (Santa Rosa) rumbo a las instalaciones del cliente en @ciudadCliente para retirar los productos.</div>
                            <div style="margin-top: 8px;">
                                @if (pasoDobleActual > 1)
                                {
                                    <span style="font-size: 11.5px; font-weight: 700; color: #2B7A4B;">✓ Salida a la ruta hacia origen efectuada</span>
                                }
                                else if (pasoDobleActual == 1)
                                {
                                    if (esConductor)
                                    {
                                        <button type="button" class="btn-lcp-primary btn-lcp-sm" onclick="marcarHito(2, 'Paso 1: Salida a la ruta desde Base LCP hacia @ciudadCliente a retirar carga')">
                                            🚗 1. Salir hacia @ciudadCliente
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11.5px; font-weight: 700; color: #8C5311; background-color: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                            🔒 En espera de salida del chofer
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--lcp-text-muted);">⏳ Pendiente</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PASO 2: LLEGAR A ORIGEN / CLIENTE -->
                    <div class="milestone-box @(pasoDobleActual > 2 ? "milestone-done" : (pasoDobleActual == 2 ? "milestone-current" : "milestone-pending"))" id="stepFlota2">
                        <div class="milestone-icon">@(pasoDobleActual > 2 ? "✓" : "2")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">2. Llegar a instalaciones del cliente</div>
                            <div class="milestone-desc">Arribo al establecimiento del cliente en @ciudadCliente para iniciar la carga (@Model.PesoTotalKg.ToString("N0") kg).</div>
                            <div style="margin-top: 8px;">
                                @if (pasoDobleActual > 2)
                                {
                                    <span style="font-size: 11.5px; font-weight: 700; color: #2B7A4B;">✓ Llegada a cliente confirmada</span>
                                }
                                else if (pasoDobleActual == 2)
                                {
                                    if (esConductor)
                                    {
                                        <button type="button" class="btn-lcp-primary btn-lcp-sm" style="background-color: #C2821E; border-color: #C2821E;" onclick="marcarHito(2, 'Paso 2: Llegada a instalaciones del cliente en @ciudadCliente')">
                                            📍 2. Llegar a @ciudadCliente
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11.5px; font-weight: 700; color: #8C5311; background-color: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                            🔒 En tránsito hacia el cliente
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--lcp-text-muted);">⏳ Pendiente</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PASO 3: CARGA DE MERCADERÍA EN CLIENTE -->
                    <div class="milestone-box @(pasoDobleActual > 3 ? "milestone-done" : (pasoDobleActual == 3 ? "milestone-current" : "milestone-pending"))" id="stepFlota3">
                        <div class="milestone-icon">@(pasoDobleActual > 3 ? "✓" : "3")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">3. Mercadería cargada en el camión</div>
                            <div class="milestone-desc">Carga física completada en las instalaciones del cliente. Remito de carga conformado.</div>
                            <div style="margin-top: 8px;">
                                @if (pasoDobleActual > 3)
                                {
                                    <span style="font-size: 11.5px; font-weight: 700; color: #2B7A4B;">✓ Mercadería cargada en origen</span>
                                }
                                else if (pasoDobleActual == 3)
                                {
                                    if (esConductor)
                                    {
                                        <button type="button" class="btn-lcp-primary btn-lcp-sm" style="background-color: #2ECC71; border-color: #2ECC71; color: #162E3B; font-weight: 800;" onclick="marcarHito(2, 'Paso 3: Carga de mercadería completada en @ciudadCliente')">
                                            📦 3. Carga completada en cliente
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11.5px; font-weight: 700; color: #8C5311; background-color: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                            🔒 En proceso de carga en origen
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--lcp-text-muted);">⏳ Pendiente</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PASO 4: EN VIAJE DE RETORNO A BASE LCP -->
                    <div class="milestone-box @(pasoDobleActual > 4 ? "milestone-done" : (pasoDobleActual == 4 ? "milestone-current" : "milestone-pending"))" id="stepFlota4">
                        <div class="milestone-icon">@(pasoDobleActual > 4 ? "✓" : "4")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">4. En viaje de retorno a Base LCP</div>
                            <div class="milestone-desc">Tránsito carretero de regreso hacia el Nodo Central Logística Centro País en Santa Rosa con la carga a bordo.</div>
                            <div style="margin-top: 8px;">
                                @if (pasoDobleActual > 4)
                                {
                                    <span style="font-size: 11.5px; font-weight: 700; color: #2B7A4B;">✓ En viaje de retorno hacia Base LCP</span>
                                }
                                else if (pasoDobleActual == 4)
                                {
                                    if (esConductor)
                                    {
                                        <button type="button" class="btn-lcp-primary btn-lcp-sm" style="background-color: #162E3B; border-color: #162E3B; color: #FFF;" onclick="marcarHito(2, 'Paso 4: En viaje de retorno hacia Base Central LCP con la carga')">
                                            🔄 4. Iniciar retorno a LCP
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11.5px; font-weight: 700; color: #8C5311; background-color: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                            🔒 Esperando inicio de retorno
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--lcp-text-muted);">⏳ Pendiente</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PASO 5: ARRIBO A BASE LCP Y ATRAQUE EN DÁRSENA -->
                    <div class="milestone-box @(pasoDobleActual > 5 ? "milestone-done" : (pasoDobleActual == 5 ? "milestone-current" : "milestone-pending"))" id="stepFlota5">
                        <div class="milestone-icon">@(pasoDobleActual > 5 ? "✓" : "5")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">5. Arribo a Base LCP y atraque en dársena</div>
                            <div class="milestone-desc">Ingreso al predio por Calle San Martín 245 y atraque en <strong>@Model.DarsenaCodigo</strong>. Al posicionar el camión, el Operador de Patio iniciará la descarga física y el guardado de stock.</div>
                            <div style="margin-top: 8px;">
                                @if (pasoDobleActual > 5)
                                {
                                    <span style="font-size: 11.5px; font-weight: 700; color: #2B7A4B;">✓ Camión arribado a LCP y posicionado en dársena</span>
                                }
                                else if (pasoDobleActual == 5)
                                {
                                    if (esConductor)
                                    {
                                        <button type="button" class="btn-lcp-primary btn-lcp-sm" style="background-color: #2ECC71; border-color: #2ECC71; color: #162E3B; font-weight: 800;" onclick="marcarHito(4, 'Paso 5: Llegada a Base LCP por Calle San Martín 245 - Posicionado en dársena @Model.DarsenaCodigo para descarga')">
                                            🏁 5. Llegar a LCP - Posicionado en Dárcena
                                        </button>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11.5px; font-weight: 700; color: #8C5311; background-color: #FEF3C7; padding: 4px 8px; border-radius: 4px;">
                                            🔒 En ruta de regreso a LCP
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--lcp-text-muted);">⏳ Pendiente</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- PASO 6: DESCARGA FÍSICA Y GUARDADO EN DÁRSENA (OPERADOR DE PATIO) -->
                    <div class="milestone-box @(Model.Estado == EstadoSolicitud.Completada ? "milestone-done" : (pasoDobleActual == 6 ? "milestone-current" : "milestone-pending"))" id="stepFlota6">
                        <div class="milestone-icon">@(Model.Estado == EstadoSolicitud.Completada ? "✓" : "6")</div>
                        <div class="milestone-content">
                            <div class="milestone-title">6. Descarga y Guardado en Dársena</div>
                            <div class="milestone-desc">Descarga física del camión, verificación de mercadería e ingreso al inventario (Lotes de stock) y emisión de liquidación por el Operador de Patio de LCP.</div>
                            <div style="margin-top: 8px;">
                                @if (Model.Estado == EstadoSolicitud.Completada)
                                {
                                    <span style="font-size: 11.5px; font-weight: 800; color: #2B7A4B;">✅ Descarga completada y nuevo stock registrado en dársena</span>
                                }
                                else if (pasoDobleActual == 6)
                                {
