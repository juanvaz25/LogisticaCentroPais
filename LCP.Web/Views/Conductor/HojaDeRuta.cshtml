                <tr>
                    <td style="color: var(--lcp-text-muted);">Puerta de Ingreso:</td>
                    <td style="font-weight: 700; color: #C2821E;">Calle San Martín 245 (Predio Central LCP)</td>
                </tr>
                <tr>
                    <td style="color: var(--lcp-text-muted);">Turno Oficial:</td>
                    <td style="font-weight: 700;">@Model.FechaHoraTurnoProgramado.ToString("dd/MM/yyyy HH:mm") hs</td>
                </tr>
                <tr>
                    <td style="color: var(--lcp-text-muted);">Mercadería:</td>
                    <td style="font-weight: 600;">@Model.DescripcionMercaderia</td>
                </tr>
                <tr>
                    <td style="color: var(--lcp-text-muted);">Peso Total:</td>
                    <td style="font-weight: 700;">@Model.PesoTotalKg.ToString("N1") kg</td>
                </tr>
                <tr>
                    <td style="color: var(--lcp-text-muted);">Volumen Total:</td>
                    <td style="font-weight: 700;">@Model.VolumenTotalM3.ToString("N2") m³</td>
                </tr>
                @if (Model.ConductorPatente != null)
                {
                    <tr>
                        <td style="color: var(--lcp-text-muted);">Patente Camión:</td>
                        <td style="font-weight: 700;">@Model.ConductorPatente</td>
                    </tr>
                }
            </table>
        </div>

        <!-- ADJUNTAR FACTURA / REMITO / CONSTANCIA FIRMADA -->
        <div class="lcp-card" style="margin: 0;">
            <h2 class="lcp-card-title">🧾 Cargar Factura / Remito de la Operación</h2>
            <p style="font-size: 12px; color: var(--lcp-text-muted); margin: 0 0 12px;">
                Cargá la <strong>factura comercial</strong> o remito firmado de la carga. Esto es un requisito obligatorio para que el auditor pueda validar la liquidación contable.
            </p>
            <form asp-controller="Solicitudes" asp-action="SubirDocumento" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="solicitudId" value="@Model.Id" />
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <select name="tipoDocumento" class="form-input" style="font-size: 12px; padding: 6px;">
                        <option value="Factura">🧾 Factura Comercial / Comprobante</option>
                        <option value="RemitoConformado" selected>📄 Remito Conformado / Firma</option>
                        <option value="CartaDePorte">📜 Carta de Porte Electrónica</option>
                    </select>
                    <div style="display: flex; gap: 8px;">
                        <input type="file" name="archivo" class="form-input" required accept=".pdf,image/*" style="font-size: 12px; padding: 6px;" />
                        <button type="submit" class="btn-lcp-primary btn-lcp-sm" style="white-space: nowrap; font-weight: 700;">
                            📤 Subir
                        </button>
                    </div>
                </div>
            </form>
        </div>

    </div>

    <!-- COLUMNA DERECHA: MAPA LEAFLET INTERACTIVO EN VIVO -->
    <div>
        <div class="lcp-card" style="padding: 0; overflow: hidden; margin: 0; border: 1px solid var(--lcp-card-border); box-shadow: 0 4px 18px rgba(0,0,0,0.06);">
            
            <!-- HEADER DEL MAPA -->
            <div style="padding: 16px 20px; background-color: #FFFFFF; border-bottom: 1px solid var(--lcp-card-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <div>
                    <h3 style="font-size: 16px; font-weight: 800; color: #192A33; margin: 0;">
                        🗺️ Trazado de Hoja de Ruta e Itinerario Vial
                    </h3>
                    <div style="font-size: 12px; color: var(--lcp-text-muted); margin-top: 2px;">
                        @(esDoble ? $"Circuito Doble Viaje: Base LCP Santa Rosa ➔ {ciudadCliente} ➔ Base LCP Santa Rosa" : $"Trayecto Directo: {ciudadCliente} ➔ Base LCP Santa Rosa")
                    </div>
                </div>

                <!-- LEYENDA DEL MAPA -->
                <div style="display: flex; align-items: center; gap: 14px; font-size: 11px; font-weight: 700;">
                    @if (esDoble)
                    {
                        <span style="display: inline-flex; align-items: center; gap: 5px; color: #28536B;">
                            <span style="width: 14px; height: 4px; background-color: #28536B; border-radius: 2px; display: inline-block;"></span> Tramo 1 (Salida)
                        </span>
                        <span style="display: inline-flex; align-items: center; gap: 5px; color: #2B7A4B;">
                            <span style="width: 14px; height: 4px; background-color: #2B7A4B; border-radius: 2px; display: inline-block;"></span> Tramo 2 (Retorno a Dárcena)
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-flex; align-items: center; gap: 5px; color: #2B7A4B;">
                            <span style="width: 14px; height: 4px; background-color: #2B7A4B; border-radius: 2px; display: inline-block;"></span> Trayecto Carretero Directo
                        </span>
                    }
                </div>
            </div>

            <!-- CONTENEDOR MAPA LEAFLET -->
            <div id="mapaHojaRuta" style="height: 520px; width: 100%; position: relative; z-index: 1;"></div>

            <!-- TELEMETRÍA Y DATOS VIALES AL PIE DEL MAPA -->
            <div style="padding: 16px 20px; background-color: #F8F6F0; border-top: 1px solid var(--lcp-card-border); display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; font-size: 12px;">
                <div>
                    <span style="font-size: 11px; text-transform: uppercase; color: var(--lcp-text-muted); font-weight: 700;">Distancia Total</span>
                    <div style="font-size: 16px; font-weight: 800; color: var(--lcp-text-dark); margin-top: 2px;">
                        @kmTotales.ToString("N0") km @(esDoble ? "(Ida y Vuelta)" : "")
                    </div>
                </div>

                <div>
                    <span style="font-size: 11px; text-transform: uppercase; color: var(--lcp-text-muted); font-weight: 700;">Tiempo Estimado Conducción</span>
                    <div style="font-size: 16px; font-weight: 800; color: #C2821E; margin-top: 2px;">
                        @{
                            double horasEstimadas = (double)kmTotales / 72.0;
                            int hs = (int)horasEstimadas;
                            int mins = (int)((horasEstimadas - hs) * 60);
                        }
                        ~@hs h @mins min (a 72 km/h prom.)
                    </div>
                </div>

                <div>
                    <span style="font-size: 11px; text-transform: uppercase; color: var(--lcp-text-muted); font-weight: 700;">Corredor Vial Asignado</span>
                    <div style="font-size: 14px; font-weight: 700; color: var(--lcp-primary); margin-top: 2px;">
                        RN 5 / RN 35 · Pampa Central
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- MODAL PARA REPORTAR DEMORA O INCIDENTE -->
<div id="modalIncidente" class="lcp-modal-backdrop" style="display: none;">
    <div class="lcp-modal" style="max-width: 480px;">
        <div class="lcp-modal-header" style="border-bottom: 2px solid #C0392B;">
            <h3 style="font-size: 17px; font-weight: 800; color: #C0392B; margin: 0; display: flex; align-items: center; gap: 8px;">
                🚨 Reportar Demora o Incidente en Ruta
            </h3>
            <button type="button" class="lcp-modal-close" onclick="cerrarModalIncidente()">&times;</button>
        </div>

        <form asp-action="ReportarIncidente" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="solicitudId" value="@Model.Id" />

            <div class="lcp-modal-body">
                <p style="font-size: 13px; color: var(--lcp-text-dark); margin: 0 0 14px; line-height: 1.5;">
                    Al reportar un incidente, se actualizará el estado de la hoja de ruta a <strong>Demora / Incidente</strong> y se enviará una notificación en vivo al operador de patio y al cliente.
                </p>

                <div class="form-group">
                    <label class="form-label">Motivo o causa de la demora / novedad: *</label>
                    <textarea name="motivo" class="form-input" rows="3" required placeholder="Ej: Pinchadura en km 280 de RN 5. Esperando auxilio mecánico. Estimación 1h de demora."></textarea>
                </div>
            </div>

            <div class="lcp-modal-footer">
                <button type="button" class="btn-lcp-outline btn-lcp-sm" onclick="cerrarModalIncidente()">Cancelar</button>
                <button type="submit" class="btn-lcp-primary btn-lcp-sm" style="background-color: #C0392B; border-color: #C0392B;">
                    Notificar Incidente
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <style>
        .milestone-box {
            display: flex;
            gap: 14px;
            padding: 14px 16px;
            border-radius: 8px;
            border: 1px solid var(--lcp-card-border);
            background-color: #FFFFFF;
            transition: all 0.2s ease;
        }
        .milestone-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #EFECE6;
            color: var(--lcp-text-muted);
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 14px;
        }
        .milestone-content {
            flex: 1;
        }
        .milestone-title {
            font-weight: 700;
            font-size: 14px;
            color: var(--lcp-text-dark);
        }
        .milestone-desc {
            font-size: 12px;
            color: var(--lcp-text-muted);
            margin-top: 2px;
        }
        .milestone-done {
            background-color: #EBF8F0;
            border-color: #C3E6D0;
        }
        .milestone-done .milestone-icon {
            background-color: #2ECC71;
            color: #FFFFFF;
        }
        .milestone-done .milestone-icon::after {
            content: "✓";
        }
        .milestone-current {
            background-color: #F8F6F0;
            border-left: 4px solid var(--lcp-primary);
        }
        .milestone-current .milestone-icon {
            background-color: var(--lcp-primary);
            color: #FFFFFF;
        }
        .milestone-pending {
            opacity: 0.65;
        }
        .lcp-modal-backdrop {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(22, 46, 59, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        .lcp-modal {
            background: #FFFFFF;
            border-radius: 8px;
            width: 90%;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            overflow: hidden;
        }
        .lcp-modal-header {
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .lcp-modal-close {
            background: none; border: none; font-size: 24px; cursor: pointer; color: var(--lcp-text-muted);
        }
        .lcp-modal-body {
            padding: 20px;
        }
        .lcp-modal-footer {
            padding: 14px 20px;
            background: #F8F6F0;
            border-top: 1px solid var(--lcp-card-border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
    </style>

    <script>
        // COORDENADAS BASE CENTRAL LCP (SANTA ROSA, LA PAMPA)
        const BASE_LCP = {
            nombre: "Nodo Central Logística Centro País",
            direccion: "Calle San Martín 245, Santa Rosa, La Pampa",
            lat: -36.6204,
            lng: -64.2906
        };

        // MATRIZ DE CIUDADES DE ARGENTINA
        const CIUDADES_ARGENTINA = [
            { nombre: "Buenos Aires (CABA)", km: 615, lat: -34.6037, lng: -58.3816 },
            { nombre: "General Pico, La Pampa", km: 135, lat: -35.6566, lng: -63.7568 },
            { nombre: "Bahía Blanca, Buenos Aires", km: 330, lat: -38.7183, lng: -62.2663 },
            { nombre: "Córdoba Capital", km: 610, lat: -31.4201, lng: -64.1888 },
            { nombre: "Río Cuarto, Córdoba", km: 410, lat: -33.1232, lng: -64.3499 },
            { nombre: "Rosario, Santa Fe", km: 590, lat: -32.9468, lng: -60.6393 },
            { nombre: "Neuquén Capital", km: 520, lat: -38.9516, lng: -68.0591 },
            { nombre: "Mendoza Capital", km: 580, lat: -32.8895, lng: -68.8458 },
            { nombre: "San Rafael, Mendoza", km: 490, lat: -34.6177, lng: -68.3301 },
            { nombre: "San Carlos de Bariloche, Río Negro", km: 920, lat: -41.1335, lng: -71.3103 },
            { nombre: "Mar del Plata, Buenos Aires", km: 690, lat: -38.0055, lng: -57.5562 },
            { nombre: "San Luis Capital", km: 460, lat: -33.2950, lng: -66.3356 },
            { nombre: "Trelew, Chubut", km: 780, lat: -43.2490, lng: -65.3051 },
            { nombre: "Viedma, Río Negro", km: 510, lat: -40.8135, lng: -62.9967 },
            { nombre: "Santa Fe Capital", km: 660, lat: -31.6333, lng: -60.7000 },
            { nombre: "San Miguel de Tucumán", km: 1180, lat: -26.8083, lng: -65.2176 },
            { nombre: "Salta Capital", km: 1350, lat: -24.7859, lng: -65.4117 },
            { nombre: "Corrientes Capital", km: 1120, lat: -27.4692, lng: -58.8306 },
            { nombre: "Comodoro Rivadavia, Chubut", km: 1160, lat: -45.8647, lng: -67.4966 },
            { nombre: "Río Gallegos, Santa Cruz", km: 1950, lat: -51.6226, lng: -69.2181 }
        ];

        const esDobleViaje = @(esDoble ? "true" : "false");
        const esConductor = @(esConductor ? "true" : "false");
        const esDespacho = @(esDespacho ? "true" : "false");
        const ciudadNombre = "@Html.Raw(ciudadCliente)";
        const solicitudId = @Model.Id;

        let map = null;
        let markerBase = null;
        let markerCliente = null;
        let markerCamion = null;
        let polylineIda = null;
        let polylineVuelta = null;

        function buscarCoordenadasCiudad(nombre) {
            if (!nombre) return CIUDADES_ARGENTINA[0];
            const lower = nombre.toLowerCase();
            const encontrada = CIUDADES_ARGENTINA.find(c => lower.includes(c.nombre.toLowerCase()) || c.nombre.toLowerCase().includes(lower));
            return encontrada || CIUDADES_ARGENTINA[0];
        }

        function inicializarMapaHojaRuta() {
            const ciudad = buscarCoordenadasCiudad(ciudadNombre);

            map = L.map('mapaHojaRuta').setView([BASE_LCP.lat, BASE_LCP.lng], 6);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 18
            }).addTo(map);

            // ÍCONOS PERSONALIZADOS
            const iconHub = L.divIcon({
                className: 'custom-hub-icon',
                html: '<div style="background-color: #162E3B; color: #FFF; border: 2px solid #FFF; border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">🏢</div>',
                iconSize: [34, 34],
                iconAnchor: [17, 17]
            });

            const iconPlanta = L.divIcon({
                className: 'custom-planta-icon',
                html: '<div style="background-color: #C2821E; color: #FFF; border: 2px solid #FFF; border-radius: 50%; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">🏭</div>',
                iconSize: [34, 34],
                iconAnchor: [17, 17]
            });

            const iconCamion = L.divIcon({
                className: 'custom-camion-icon',
                html: '<div style="background-color: #2ECC71; color: #162E3B; border: 2px solid #FFF; border-radius: 50%; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 4px 12px rgba(46, 204, 113, 0.5); animation: pulse 2s infinite;">🚚</div>',
                iconSize: [38, 38],
                iconAnchor: [19, 19]
            });

            // MARCADOR BASE LCP
            markerBase = L.marker([BASE_LCP.lat, BASE_LCP.lng], { icon: iconHub }).addTo(map)
                .bindPopup(`<b>${BASE_LCP.nombre}</b><br>${BASE_LCP.direccion}<br><b>Dársena asignada:</b> @Model.DarsenaCodigo`)
                .openPopup();

            // MARCADOR CLIENTE
            markerCliente = L.marker([ciudad.lat, ciudad.lng], { icon: iconPlanta }).addTo(map)
                .bindPopup(`<b>Planta / Punto Cliente</b><br>${ciudad.nombre}<br><b>Cliente:</b> @Model.ClienteRazonSocial<br><b>Carga:</b> @Model.DescripcionMercaderia`);

            // TRAZADO DE RUTAS
            if (esDobleViaje) {
                // TRAMO 1: SALIDA DE BASE LCP A DESTINO CLIENTE CON CARGA
                const tramo1Coords = [
                    [BASE_LCP.lat, BASE_LCP.lng],
                    [ciudad.lat, ciudad.lng]
                ];
                polylineIda = L.polyline(tramo1Coords, {
                    color: '#28536B',
                    weight: 6,
                    opacity: 0.85
                }).addTo(map);

                // TRAMO 2: RETORNO A BASE LCP DESPUÉS DE DESPACHAR
                const offsetLat = 0.08;
                const offsetLng = 0.08;
                const tramo2Coords = [
                    [ciudad.lat + offsetLat, ciudad.lng + offsetLng],
                    [BASE_LCP.lat + offsetLat, BASE_LCP.lng + offsetLng]
                ];
                polylineVuelta = L.polyline(tramo2Coords, {
                    color: '#2B7A4B',
                    weight: 6,
                    opacity: 0.85,
                    dashArray: '10, 8'
                }).addTo(map);

                // MARCADOR CAMIÓN EN POSICIÓN INTERMEDIA
                const midLat = (BASE_LCP.lat + ciudad.lat) / 2;
                const midLng = (BASE_LCP.lng + ciudad.lng) / 2;
                markerCamion = L.marker([midLat, midLng], { icon: iconCamion }).addTo(map)
                    .bindPopup(`<b>Unidad en Ruta · Flota LCP</b><br>Camión: @(Model.ConductorPatente ?? "Oficial")<br>Conductor: @(Model.ConductorNombreCompleto ?? "Carlos Fernández")<br>Doble Viaje: Despacho a destino y retorno a LCP`);

                map.fitBounds(L.latLngBounds([
                    [BASE_LCP.lat, BASE_LCP.lng],
                    [ciudad.lat, ciudad.lng]
                ]), { padding: [60, 60] });
            } else {
                // VIAJE SIMPLE DIRECTO (ORIGEN CLIENTE ➔ BASE LCP o BASE LCP ➔ CLIENTE)
                const tramoDirecto = esDespacho
                    ? [[BASE_LCP.lat, BASE_LCP.lng], [ciudad.lat, ciudad.lng]]
                    : [[ciudad.lat, ciudad.lng], [BASE_LCP.lat, BASE_LCP.lng]];

                polylineIda = L.polyline(tramoDirecto, {
                    color: '#2B7A4B',
                    weight: 6,
                    opacity: 0.9
                }).addTo(map);

                const midLat = (BASE_LCP.lat + ciudad.lat) / 2;
                const midLng = (BASE_LCP.lng + ciudad.lng) / 2;
                markerCamion = L.marker([midLat, midLng], { icon: iconCamion }).addTo(map)
                    .bindPopup(`<b>Camión Propio en Ruta</b><br>${esDespacho ? "Traslado hacia destino en " + ciudad.nombre : "Traslado directo hacia Base LCP"}`);

                map.fitBounds(L.latLngBounds(tramoDirecto), { padding: [60, 60] });
            }
        }

        async function marcarHito(estadoNum, hitoDescripcion) {
            if (!esConductor) {
                alert("Modo solo lectura: solo el chofer asignado puede actualizar los hitos y etapas de su viaje.");
                return;
            }
            try {
                const response = await fetch(`/Conductor/ActualizarViajeAjax/${solicitudId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        estadoViaje: estadoNum,
                        hitoAlcanzado: hitoDescripcion,
                        observaciones: hitoDescripcion
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.exitoso) {
                        // Feedback inmediato visual
                        document.getElementById("badgeEstadoViajeVivo").textContent = `Viaje: Actualizado`;
                        document.getElementById("badgeEstadoViajeVivo").style.backgroundColor = "#2ECC71";

                        // Recargar vista para reflejar checklist y persistencia
                        window.location.reload();
                    } else {
                        alert("No se pudo actualizar el estado de la hoja de ruta.");
                    }
                }
            } catch (err) {
                console.error(err);
                alert("Error al comunicarse con el servidor.");
            }
        }

        function abrirModalIncidente() {
            document.getElementById("modalIncidente").style.display = "flex";
        }

        function cerrarModalIncidente() {
            document.getElementById("modalIncidente").style.display = "none";
        }

        document.addEventListener("DOMContentLoaded", function () {
            inicializarMapaHojaRuta();
        });
    </script>
}
