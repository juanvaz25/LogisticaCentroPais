                    <!-- PASO 3: SALIDA Y TRÁNSITO HACIA DESTINO -->
                    <div class="milestone-box @(pasoPropioActual > 3 ? "milestone-done" : (pasoPropioActual == 3 ? "milestone-current" : "milestone-pending"))" id="stepPropioDesp3">
