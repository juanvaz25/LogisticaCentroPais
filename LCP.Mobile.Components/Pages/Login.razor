@page "/login"
@layout MobileLayout
@inject IMobileApiClient ApiClient
@inject ITokenStorage TokenStorage
@inject NavigationManager Nav
@inject UiNotificationService Notifier

<div style="padding: 10px 4px; display: flex; flex-direction: column; justify-content: center; min-height: 80vh;">
    <!-- Logo & Welcome -->
    <div style="text-align: center; margin-bottom: 24px;">
        <div style="width: 68px; height: 68px; margin: 0 auto 12px; border-radius: 18px; background: linear-gradient(135deg, #C2821E 0%, #28536B 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(194, 130, 30, 0.35);">
            <i class="fa-solid fa-truck-ramp-box" style="font-size: 28px; color: white;"></i>
        </div>
        <h2 style="font-size: 1.45rem; font-weight: 800; color: var(--lcp-navy); margin-bottom: 4px;">Logística Centro País</h2>
        <p style="font-size: 0.85rem; color: var(--lcp-text-muted);">Acceso Unificado al Hub Logístico Pampeano</p>
    </div>

    <!-- Login Card -->
    <div class="card-lcp" style="padding: 22px;">
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-group-lcp">
                <label class="form-label-lcp">Correo Electrónico</label>
                <div style="position: relative;">
                    <i class="fa-solid fa-envelope" style="position: absolute; left: 14px; top: 15px; color: #94A3B8;"></i>
                    <InputText @bind-Value="loginModel.Email" class="form-input-lcp" style="padding-left: 40px;" placeholder="usuario@lcp.com" />
                </div>
            </div>

            <div class="form-group-lcp">
                <label class="form-label-lcp">Contraseña</label>
                <div style="position: relative;">
                    <i class="fa-solid fa-lock" style="position: absolute; left: 14px; top: 15px; color: #94A3B8;"></i>
                    <input type="@(ShowPassword ? "text" : "password")" @bind="loginModel.Password" class="form-input-lcp" style="padding-left: 40px; padding-right: 40px;" placeholder="••••••••" />
                    <button type="button" @onclick="() => ShowPassword = !ShowPassword" style="position: absolute; right: 12px; top: 13px; background: none; border: none; color: #94A3B8; cursor: pointer;">
                        <i class="fa-solid @(ShowPassword ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; font-size: 0.82rem;">
                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--lcp-text-muted);">
                    <input type="checkbox" @bind="loginModel.Recordarme" style="accent-color: var(--lcp-teal);" />
                    <span>Recordar sesión</span>
                </label>
                <span style="color: var(--lcp-teal); font-weight: 600;">¿Olvidó su clave?</span>
            </div>

            <button type="submit" class="btn-lcp-primary" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <i class="fa-solid fa-circle-notch fa-spin"></i>
                    <span>Iniciando sesión...</span>
                }
                else
                {
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Ingresar al Sistema</span>
                }
            </button>
        </EditForm>
    </div>

    <!-- Quick Role Switcher for Demo / Evaluation -->
    <div style="margin-top: 10px;">
        <div style="text-align: center; font-size: 0.75rem; font-weight: 700; color: var(--lcp-text-muted); text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.5px;">
            Acceso Rápido por Rol (Evaluación)
        </div>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;">
            <button type="button" class="btn-lcp-outline btn-lcp-sm" @onclick='() => SetDemoUser("admin@lcp.com", "Admin123!")' style="border-left: 4px solid #EF4444; justify-content: flex-start;">
                <i class="fa-solid fa-shield-halved" style="color: #EF4444;"></i>
                <div style="text-align: left; line-height: 1.1;">
                    <div style="font-weight: 700; font-size: 0.78rem;">Administrador</div>
                    <div style="font-size: 0.65rem; color: #94A3B8;">Roberto Gómez</div>
                </div>
            </button>

            <button type="button" class="btn-lcp-outline btn-lcp-sm" @onclick='() => SetDemoUser("operador@lcp.com", "Operador123!")' style="border-left: 4px solid #C2821E; justify-content: flex-start;">
                <i class="fa-solid fa-people-carry-box" style="color: #C2821E;"></i>
                <div style="text-align: left; line-height: 1.1;">
                    <div style="font-weight: 700; font-size: 0.78rem;">Operador</div>
                    <div style="font-size: 0.65rem; color: #94A3B8;">Martín Benítez</div>
                </div>
            </button>

            <button type="button" class="btn-lcp-outline btn-lcp-sm" @onclick='() => SetDemoUser("auditor@lcp.com", "Auditor123!")' style="border-left: 4px solid #8B5CF6; justify-content: flex-start;">
                <i class="fa-solid fa-clipboard-check" style="color: #8B5CF6;"></i>
                <div style="text-align: left; line-height: 1.1;">
                    <div style="font-weight: 700; font-size: 0.78rem;">Auditor</div>
                    <div style="font-size: 0.65rem; color: #94A3B8;">Lucía Pereyra</div>
                </div>
            </button>

            <button type="button" class="btn-lcp-outline btn-lcp-sm" @onclick='() => SetDemoUser("cliente@pampeana.com", "Cliente123!")' style="border-left: 4px solid #0284C7; justify-content: flex-start;">
                <i class="fa-solid fa-building" style="color: #0284C7;"></i>
                <div style="text-align: left; line-height: 1.1;">
                    <div style="font-weight: 700; font-size: 0.78rem;">Cliente Empresa</div>
                    <div style="font-size: 0.65rem; color: #94A3B8;">Dist. Pampeana</div>
                </div>
            </button>
        </div>

        <div style="margin-top: 8px;">
            <button type="button" class="btn-lcp-outline btn-lcp-sm" @onclick='() => SetDemoUser("conductor@flota.com", "Chofer123!")' style="border-left: 4px solid #10B981; width: 100%; justify-content: flex-start;">
                <i class="fa-solid fa-truck" style="color: #10B981;"></i>
                <div style="text-align: left; line-height: 1.1;">
                    <div style="font-weight: 700; font-size: 0.78rem;">Conductor Flota LCP</div>
                    <div style="font-size: 0.65rem; color: #94A3B8;">Esteban Morales (Mercedes-Benz Actros)</div>
                </div>
            </button>
        </div>
    </div>
</div>

@code {
    private LoginRequestDto loginModel = new()
    {
        Email = "operador@lcp.com",
        Password = "Admin123!"
    };

    private bool ShowPassword = false;
    private bool IsLoading = false;

    private async Task SetDemoUser(string email, string pass)
    {
        loginModel.Email = email;
        loginModel.Password = pass;
        await HandleLogin();
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            Notifier.Warning("Por favor ingrese correo y contraseña");
            return;
        }

        IsLoading = true;
        try
        {
            var res = await ApiClient.LoginAsync(loginModel);
            if (res.Exitoso)
            {
                Notifier.Success($"Bienvenido/a {res.Usuario?.NombreCompleto}");
                Nav.NavigateTo("/");
            }
            else
            {
                Notifier.Error(res.Mensaje ?? "Error al autenticar");
            }
        }
        catch (Exception ex)
        {
            Notifier.Error($"Error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }
}
