    </div>

    <!-- Bottom Phases & Action -->
    <div class="intro-mob-bottom">
        <div class="intro-mob-phases">
            <div class="phase-chip @(CurrentPhase >= 1 ? "active" : "")">
                <span class="phase-dot"></span>
                <span>1. IDENTIDAD</span>
            </div>
            <div class="phase-chip @(CurrentPhase >= 2 ? "active" : "")">
                <span class="phase-dot"></span>
                <span>2. LA PAMPA</span>
            </div>
            <div class="phase-chip @(CurrentPhase >= 3 ? "active" : "")">
                <span class="phase-dot"></span>
                <span>3. CORREDORES</span>
            </div>
        </div>

        <button type="button" class="btn-mob-enter" @onclick="FinishIntro">
            <span>Ingresar al Sistema</span>
            <i class="fa-solid fa-arrow-right" style="font-size: 13px;"></i>
        </button>
    </div>

    <!-- Progress line at the bottom -->
    <div class="intro-mob-progress">
        <div class="intro-mob-progress-bar" style="width: @(ProgressPercent)%;"></div>
    </div>
</div>

<style>
.mobile-intro-screen {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: #07090C;
    color: #FFFFFF;
    padding: 16px 14px 20px;
    box-sizing: border-box;
    overflow: hidden;
}

.intro-mob-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
}

.intro-mob-badge {
    background: #FFFFFF;
    color: #0E1114;
    font-weight: 900;
    font-size: 13px;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
}

.intro-mob-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: #94A3B8;
    letter-spacing: 0.5px;
}

.btn-mob-skip {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid #334155;
    color: #CBD5E1;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-mob-skip:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.intro-mob-center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
}

.intro-svg-box {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.intro-mob-bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 10;
}

.intro-mob-phases {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    font-family: monospace;
}

.phase-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #475569;
    transition: color 0.3s;
}

.phase-chip.active {
    color: #FAF8F5;
    font-weight: 700;
}

.phase-chip .phase-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #334155;
    transition: all 0.3s;
}

.phase-chip.active .phase-dot {
    background: #FFFFFF;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
}

.btn-mob-enter {
    background: #FFFFFF;
    color: #07090C;
    border: none;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 12px;
    border-radius: 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: all 0.2s;
}
.btn-mob-enter:active {
    transform: scale(0.98);
}

.intro-mob-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #111D23;
}

.intro-mob-progress-bar {
    height: 100%;
    background: #FFFFFF;
    transition: width 0.1s linear;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
}

/* Animations matching LCP Web */
.intro-animating #lcp-intro-badge {
    animation: fadeBadgeOut 0.8s 1.2s forwards ease-in-out;
    transform-origin: 470px 285px;
}

.intro-animating .la-pampa-path-anim {
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    animation: drawPampaOutline 1.5s 1.0s forwards cubic-bezier(0.2, 0, 0.2, 1);
}

.intro-animating .map-route-line {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: drawRoutes 1.2s 1.8s forwards ease-out;
}

.intro-animating .map-node-element,
.intro-animating .map-dest-card {
    opacity: 0;
    animation: fadeInElements 0.8s 2.2s forwards ease-out;
}

@@keyframes drawPampaOutline {
    0% { stroke-dashoffset: 2400; fill: transparent; }
    75% { stroke-dashoffset: 0; fill: transparent; }
    100% { stroke-dashoffset: 0; fill: #131B22; }
}

@@keyframes drawRoutes {
    to { stroke-dashoffset: 0; }
}

@@keyframes fadeInElements {
    to { opacity: 1; }
}

@@keyframes fadeBadgeOut {
    0% { opacity: 1; transform: scale(1); }
    40% { opacity: 0.9; transform: scale(1.15); }
    100% { opacity: 0; transform: scale(1.8); visibility: hidden; pointer-events: none; }
}

.radar-ping-ring {
    animation: pingRing 2s infinite ease-out;
    transform-origin: center;
}

@@keyframes pingRing {
    0% { r: 6px; opacity: 1; }
    100% { r: 24px; opacity: 0; }
}
</style>

@code {
    private int CurrentPhase = 1;
    private int ProgressPercent = 0;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _ = RunIntroSequenceAsync(_cts.Token);
    }

    private async Task RunIntroSequenceAsync(CancellationToken token)
    {
        try
        {
            var totalDurationMs = 3800;
            var intervalMs = 100;
            var steps = totalDurationMs / intervalMs;

            for (int i = 1; i <= steps; i++)
            {
                if (token.IsCancellationRequested) return;
                await Task.Delay(intervalMs, token);

                ProgressPercent = (int)((i / (double)steps) * 100);

                if (i >= steps * 0.3 && CurrentPhase < 2)
                {
                    CurrentPhase = 2;
                }
                if (i >= steps * 0.65 && CurrentPhase < 3)
                {
                    CurrentPhase = 3;
                }

                await InvokeAsync(StateHasChanged);
            }

            // Finished automatically
            await FinishIntro();
        }
        catch (TaskCanceledException)
        {
            // Cancelled when skipping
        }
    }

    private async Task FinishIntro()
    {
        _cts?.Cancel();
        await TokenStorage.SetIntroShownAsync(true);

        var isAuth = await TokenStorage.IsAuthenticatedAsync();
        if (isAuth)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            Nav.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

