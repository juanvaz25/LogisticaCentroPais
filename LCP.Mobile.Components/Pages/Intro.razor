                <!-- LCP Badge that dissolves and transforms -->
                <g id="lcp-intro-badge">
                    <circle cx="470" cy="285" r="90" fill="none" stroke="#FFFFFF" stroke-width="1" opacity="0.25" />
                    <circle cx="470" cy="285" r="140" fill="none" stroke="#FFFFFF" stroke-width="0.8" opacity="0.15" />

                    <rect x="360" y="240" width="220" height="90" rx="6" fill="#FFFFFF" stroke="#0E1114" stroke-width="3" />
