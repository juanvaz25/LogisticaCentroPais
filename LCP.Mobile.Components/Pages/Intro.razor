                    <text class="map-node-element" x="472" y="70" fill="#CBD5E1" font-size="13" font-weight="700">Realicó</text>

                    <circle class="map-node-element" cx="490" cy="140" r="5" fill="#FFFFFF" />
                    <text class="map-node-element" x="502" y="144" fill="#FFFFFF" font-size="13" font-weight="700">Gral. Pico</text>

                    <circle class="map-node-element" cx="400" cy="320" r="4.5" fill="#94A3B8" />
                    <text class="map-node-element" x="412" y="322" fill="#CBD5E1" font-size="13" font-weight="700">Gral. Acha</text>

