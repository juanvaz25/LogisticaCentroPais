                        <line x1="-18" y1="0" x2="-8" y2="0" stroke="#FFFFFF" stroke-width="1.8" />
                        <line x1="8" y1="0" x2="18" y2="0" stroke="#FFFFFF" stroke-width="1.8" />
                        <line x1="0" y1="-18" x2="0" y2="-8" stroke="#FFFFFF" stroke-width="1.8" />
                        <line x1="0" y1="8" x2="0" y2="18" stroke="#FFFFFF" stroke-width="1.8" />

                        <rect x="-195" y="-36" width="185" height="30" rx="3" fill="#0E1114" stroke="#FFFFFF" stroke-width="1.5" />
                        <text x="-187" y="-16" fill="#FFFFFF" font-size="13" font-weight="800">SANTA ROSA [LCP NODO]</text>
                        <text x="-195" y="16" fill="#94A3B8" font-size="12" font-weight="700" font-family="monospace">PREDIO LOGÍSTICO BASE</text>
