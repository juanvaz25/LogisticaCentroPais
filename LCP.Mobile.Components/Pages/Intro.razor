@page "/intro"
@layout MobileLayout
@inject IMobileApiClient ApiClient
@inject ITokenStorage TokenStorage
@inject NavigationManager Nav
@implements IDisposable

<div class="mobile-intro-screen">
    <!-- Top Telemetry & Skip Button -->
