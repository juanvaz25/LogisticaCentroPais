@page "/chat"
@page "/chat/{ConversacionId}"
@layout MobileLayout
@inject IMobileApiClient ApiClient
@inject ITokenStorage TokenStorage
@inject UiNotificationService Notifier

<div style="display: flex; flex-direction: column; height: 100%; min-height: 72vh;">
    @if (string.IsNullOrWhiteSpace(ConversacionId))
    {
        <!-- Conversations List View -->
        <div style="display: flex; flex-direction: column; gap: 12px;">
            <div>
                <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--lcp-navy);">Chat Operativo</h2>
                <div style="font-size: 0.72rem; color: var(--lcp-text-muted);">Comunicaciones en tiempo real de operaciones</div>
            </div>

            @if (IsLoading)
            {
                <div style="text-align: center; padding: 40px; color: var(--lcp-text-muted);">
                    <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 1.6rem; color: var(--lcp-teal); margin-bottom: 8px;"></i>
                    <div style="font-size: 0.8rem;">Cargando conversaciones...</div>
                </div>
            }
            else
            {
                @foreach (var c in Conversaciones)
                {
                    <a href="/chat/@c.ConversacionId" class="card-lcp" style="text-decoration: none; padding: 14px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px;">
                        <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--lcp-teal), var(--lcp-navy)); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">
                            <i class="fa-solid fa-comments"></i>
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                                <div style="font-weight: 800; font-size: 0.88rem; color: var(--lcp-navy); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @c.Titulo
                                </div>
                                <span style="font-size: 0.65rem; color: #94A3B8;">@c.HoraUltimoMensaje</span>
                            </div>
                            <div style="font-size: 0.72rem; color: var(--lcp-teal); margin-bottom: 3px;">
                                @c.Subtitulo
                            </div>
                            <div style="font-size: 0.75rem; color: var(--lcp-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @c.UltimoMensaje
                            </div>
                        </div>
                    </a>
                }
            }
        </div>
    }
    else
    {
        <!-- Chat Inside Messages Thread View -->
        <div style="display: flex; flex-direction: column; flex: 1; height: 100%;">
            <!-- Thread Top Bar -->
            <div style="display: flex; align-items: center; gap: 10px; background: white; padding: 10px 14px; border-radius: var(--radius-md); border: 1px solid var(--lcp-border); margin-bottom: 10px;">
                <a href="/chat" class="header-btn" style="background: #F1F5F9; color: var(--lcp-navy); text-decoration: none;">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
                <div style="flex: 1;">
                    <div style="font-weight: 800; font-size: 0.88rem; color: var(--lcp-navy);">
                        Operación @ConversacionId.Replace("solicitud_", "SOL-2026-")
                    </div>
                    <div style="font-size: 0.68rem; color: #10B981; display: flex; align-items: center; gap: 4px;">
                        <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #10B981;"></span>
                        Canal Tripartito Activo
                    </div>
                </div>
            </div>

            <!-- Messages Scroll Area -->
            <div style="flex: 1; overflow-y: auto; padding: 10px 4px; display: flex; flex-direction: column; gap: 10px; max-height: 52vh;">
                @foreach (var msg in Mensajes)
                {
                    var esMio = CurrentUser != null && msg.RemitenteUsuarioId == CurrentUser.Id;
                    <div style="display: flex; flex-direction: column; align-items: @(esMio ? "flex-end" : "flex-start");">
                        <div style="font-size: 0.65rem; color: #64748B; margin-bottom: 2px; padding: 0 4px;">
                            <strong>@msg.RemitenteNombre</strong> (@msg.RemitenteRol)
                        </div>

                        <div style="@(esMio
                                        ? "background: linear-gradient(135deg, var(--lcp-teal), var(--lcp-navy)); color: white; border-bottom-right-radius: 4px;"
                                        : "background: white; color: var(--lcp-text); border: 1px solid var(--lcp-border); border-bottom-left-radius: 4px;")
                                    border-radius: 16px; padding: 10px 14px; max-width: 82%; box-shadow: var(--shadow-sm); font-size: 0.85rem;">

                            @if (msg.EsIncidenteRuta)
                            {
                                <div style="display: inline-flex; align-items: center; gap: 4px; background: rgba(239, 68, 68, 0.15); color: @(esMio ? "#FEF2F2" : "#DC2626"); font-weight: 700; font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; margin-bottom: 4px;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    <span>INCIDENTE EN RUTA</span>
                                </div>
                            }

                            <div>@msg.TextoMensaje</div>

                            <div style="font-size: 0.6rem; text-align: right; margin-top: 4px; opacity: 0.75;">
                                @msg.HoraFormateada
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Bottom Sticky Input Bar -->
            <div style="margin-top: auto; padding-top: 10px;">
                <form @onsubmit="EnviarMensaje" style="display: flex; gap: 8px;">
                    <input type="text" class="form-input-lcp" placeholder="Escribe un mensaje operativo..." @bind="NuevoTextoMensaje" style="flex: 1;" />
                    <button type="submit" class="btn-lcp-gold" style="width: 48px; height: 48px; border-radius: var(--radius-md); padding: 0;" disabled="@string.IsNullOrWhiteSpace(NuevoTextoMensaje)">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? ConversacionId { get; set; }

    private List<ConversacionResumenDto> Conversaciones = new();
    private List<MensajeChatDto> Mensajes = new();
    private UsuarioDto? CurrentUser;
    private string NuevoTextoMensaje = string.Empty;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        CurrentUser = await TokenStorage.GetUserAsync();
        await Cargar();
    }

    private async Task Cargar()
    {
        IsLoading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(ConversacionId))
            {
                Conversaciones = await ApiClient.GetConversacionesChatAsync();
            }
            else
            {
                Mensajes = await ApiClient.GetHistorialChatAsync(ConversacionId);
            }
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task EnviarMensaje()
    {
        if (string.IsNullOrWhiteSpace(NuevoTextoMensaje) || string.IsNullOrWhiteSpace(ConversacionId))
            return;

        var texto = NuevoTextoMensaje.Trim();
        NuevoTextoMensaje = string.Empty;

        var dto = new EnviarMensajeDto
        {
            ConversacionId = ConversacionId,
            TextoMensaje = texto
        };

        var enviado = await ApiClient.EnviarMensajeChatAsync(dto);
        if (enviado != null)
        {
            Mensajes.Add(enviado);
        }
    }
}
