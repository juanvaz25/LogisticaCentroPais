@inject UiNotificationService Notifier
@implements IDisposable

<div class="toast-container" style="pointer-events: none;">
    @foreach (var toast in Notifier.GetActiveToasts())
    {
        <div class="toast-item @toast.Type" @onclick="() => Notifier.Dismiss(toast.Id)" style="cursor: pointer; pointer-events: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="@GetIcon(toast.Type)"></i>
                <span>@toast.Text</span>
            </div>
            <i class="fa-solid fa-xmark" style="font-size: 0.8rem; opacity: 0.8; margin-left: 8px;"></i>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Notifier.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private string GetIcon(string type) => type switch
    {
        "success" => "fa-solid fa-circle-check",
        "danger" => "fa-solid fa-triangle-exclamation",
        "warning" => "fa-solid fa-circle-exclamation",
        _ => "fa-solid fa-circle-info"
    };

    public void Dispose()
    {
        Notifier.OnChange -= HandleChange;
    }
}
