@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ITokenStorage TokenStorage
@inject UiNotificationService Notifier

<div class="mobile-viewport-container">
    <div class="mobile-phone-frame">
        <div class="phone-notch-bar">
            <span>09:41</span>
            <div class="phone-island"></div>
            <div style="display: flex; gap: 6px;">
                <i class="fa-solid fa-signal" style="font-size: 10px;"></i>
                <i class="fa-solid fa-wifi" style="font-size: 10px;"></i>
                <i class="fa-solid fa-battery-full" style="font-size: 10px;"></i>
            </div>
        </div>

        @if (!IsIntroPage)
        {
            <MobileHeader />
        }

        <main class="mobile-body @(IsIntroPage ? "mobile-body-intro" : "")">
            @Body
        </main>

        @if (!IsAuthPage && !IsIntroPage)
        {
            <MobileBottomNav />
        }

        <ToastOverlay />
    </div>
</div>

@code {
    private bool IsAuthPage => Nav.Uri.ToLowerInvariant().Contains("/login");
    private bool IsIntroPage => Nav.Uri.ToLowerInvariant().Contains("/intro");

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += async (s, e) =>
        {
            await CheckSession();
            StateHasChanged();
        };

        await CheckSession();
    }

    private async Task CheckSession()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.ToLowerInvariant();
        if (path.Contains("/login") || path.Contains("/intro"))
        {
            return;
        }

        var isAuth = await TokenStorage.IsAuthenticatedAsync();
        if (!isAuth)
        {
            Notifier.Warning("Sesión vencida tras 30 minutos de inactividad. Por favor inicie sesión nuevamente.");
            Nav.NavigateTo("/login");
        }
    }
}
